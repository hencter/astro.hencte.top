---
import { getEntry } from "astro:content";
import Layout from "../layouts/BaseLayout.astro";
import ProjectsSections from "../components/connect/ProjectsSections.astro";
import { getPageAlternates } from "../lib/i18n";
import { getProjectsStrings } from "../lib/ui-strings";

const projectsEntry = await getEntry("connect", "zh/projects");
if (!projectsEntry) {
  throw new Error("Missing connect content: zh/projects");
}

const page = projectsEntry.data;
const locale = "zh-CN";
---

<Layout
  title={page.title}
  description={page.description}
  locale={locale}
  canonicalPath="/projects"
  connectPage="projects"
  alternates={getPageAlternates("projects")}
  keywords={page.keywords ?? []}
>
  <ProjectsSections page={page} locale={locale} strings={getProjectsStrings(locale)} />
</Layout>
