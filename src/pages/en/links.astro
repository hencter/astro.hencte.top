---
import { getEntry } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import FriendLinksSections from "../../components/connect/FriendLinksSections.astro";
import { getPageAlternates } from "../../lib/i18n";
import { getLinksStrings } from "../../lib/ui-strings";

const linksEntry = await getEntry("connect", "en/links");
if (!linksEntry) {
  throw new Error("Missing connect content: en/links");
}

const page = linksEntry.data;
const locale = "en-US";
---

<Layout
  title={page.title}
  description={page.description}
  locale={locale}
  canonicalPath="/en/links"
  connectPage="links"
  alternates={getPageAlternates("links")}
  keywords={page.keywords ?? []}
>
  <FriendLinksSections page={page} locale={locale} strings={getLinksStrings(locale)} />
</Layout>
