---
import { getCollection, getEntry } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";

const homeEntry = await getEntry("connect", "en/home");
if (!homeEntry) {
  throw new Error("Missing connect content: en/home");
}

const home = homeEntry.data;
const hero = home.hero;
const focusSection = home.focusSection;
const focusAreas = home.focusAreas ?? [];
const projectsSection = home.projectsSection;
const featuredProjects = home.featuredProjects ?? [];
const buildSection = home.buildSection;
const buildSteps = home.buildSteps ?? [];
const latestSection = home.latestSection;
const cta = home.cta;

const allowedSections = new Set(["log", "tech", "ancient"]);
const isIndexPage = (entry: { data: { legacyPath?: string } }) =>
  Boolean(entry.data.legacyPath?.endsWith("_index.md"));

const allEntries = await getCollection("blog");
const latestPosts = allEntries
  .filter((entry) => !entry.data.draft)
  .filter((entry) => allowedSections.has(entry.data.section || entry.id.split("/")[0]))
  .filter((entry) => !isIndexPage(entry))
  .sort((a, b) => {
    const aTime = a.data.date ? a.data.date.getTime() : 0;
    const bTime = b.data.date ? b.data.date.getTime() : 0;
    return bTime - aTime;
  })
  .slice(0, 6);

function formatDate(date?: Date): string {
  if (!date) {
    return "Date pending";
  }
  return date.toLocaleDateString("en-US", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
}

---

<Layout
  title={home.title}
  description={home.description}
  locale="en-US"
  canonicalPath="/en"
  keywords={home.keywords ?? []}
>
  <section class="hero" id="top">
    {hero?.badge && <p class="hero-badge">{hero.badge}</p>}
    {hero?.headline && <h1 class="hero-title">{hero.headline}</h1>}
    {hero?.subtitle && <p class="hero-subtitle">{hero.subtitle}</p>}
    <div class="hero-actions">
      {hero?.actions?.primary && (
        <a class="btn-primary" href={hero.actions.primary.href}>
          {hero.actions.primary.label}
        </a>
      )}
      {hero?.actions?.secondary && (
        <a class="btn-secondary" href={hero.actions.secondary.href}>
          {hero.actions.secondary.label}
        </a>
      )}
    </div>
  </section>

  <section class="section" id="focus">
    <div class="section-heading">
      <h2 class="section-title">{focusSection?.title ?? "Core Direction"}</h2>
      {focusSection?.subtitle && <p class="section-subtitle">{focusSection.subtitle}</p>}
    </div>
    <div class="card-grid three">
      {
        focusAreas.map((item) => (
          <article class="value-card">
            <p class="card-kicker">{item.tag}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" id="projects">
    <div class="section-heading">
      <h2 class="section-title">{projectsSection?.title ?? "Featured Projects"}</h2>
      {projectsSection?.subtitle && <p class="section-subtitle">{projectsSection.subtitle}</p>}
    </div>
    <div class="card-grid three">
      {
        featuredProjects.map((project) => (
          <article class="project-card">
            <p class="card-kicker">{project.stage}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <p class="result-line">{project.outcome}</p>
            <ul class="chip-list">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            {project.url && (
              <p>
                <a
                  href={project.url}
                  target={project.url.startsWith("http") ? "_blank" : undefined}
                  rel={project.url.startsWith("http") ? "noreferrer" : undefined}
                >
                  {project.url.startsWith("http") ? "Visit project" : "Open page"}
                </a>
              </p>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" id="loop">
    <div class="section-heading">
      <h2 class="section-title">{buildSection?.title ?? "Build Loop"}</h2>
      {buildSection?.subtitle && <p class="section-subtitle">{buildSection.subtitle}</p>}
    </div>
    <div class="timeline">
      {
        buildSteps.map((item) => (
          <article class="timeline-item">
            <span>{item.phase}</span>
            <p>{item.detail}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" id="latest">
    <div class="section-heading">
      <h2 class="section-title">{latestSection?.title ?? "Latest Blog Posts"}</h2>
      {latestSection?.subtitle && <p class="section-subtitle">{latestSection.subtitle}</p>}
    </div>
    <div class="blog-list-grid">
      {
        latestPosts.map((post) => (
          <article class="blog-post-card">
            <p class="card-kicker">{post.data.section || "blog"}</p>
            <h3>
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="post-meta-line">{formatDate(post.data.date)}</p>
            <p>{post.data.description || "Open to read the full post."}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" id="contact">
    <div class="cta-banner">
      <h2>{cta?.title ?? "Follow project updates"}</h2>
      <p>{cta?.text ?? "Start from the projects page for product overviews, then jump into the blog for implementation details and technical notes."}</p>
      <div class="hero-actions">
        {cta?.actions?.primary && (
          <a class="btn-primary" href={cta.actions.primary.href}>
            {cta.actions.primary.label}
          </a>
        )}
        {cta?.actions?.secondary && (
          <a class="btn-secondary" href={cta.actions.secondary.href}>
            {cta.actions.secondary.label}
          </a>
        )}
      </div>
    </div>
  </section>
</Layout>
