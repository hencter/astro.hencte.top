---
import NovelIndexPage from "../../../layouts/NovelIndexPage.astro";
import { getCollection } from "astro:content";
import { buildNovelPageContext, findNovelIndexEntry } from "../../../lib/novel-page";

const entries = await getCollection("novel");
const entry = findNovelIndexEntry(entries, "en-US");
const ctx = await buildNovelPageContext("en-US", entry, undefined);
---

<NovelIndexPage locale={ctx.locale} novels={ctx.indexNovels} languageLinks={ctx.languageLinks} />
