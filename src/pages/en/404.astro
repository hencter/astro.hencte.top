---
import Layout from "../../layouts/BaseLayout.astro";
import { getPageAlternates } from "../../lib/i18n";

const locale = "en-US";
---

<Layout
  title="Page Not Found | Hencte"
  description="The page you requested does not exist or has moved."
  locale={locale}
  canonicalPath="/en/404"
  connectPage="home"
  alternates={getPageAlternates("home")}
  robots="noindex"
>
  <section class="error-page">
    <p class="error-code">404</p>
    <h1>Page not found</h1>
    <p class="error-lead">The link may be broken, moved, or never existed.</p>
    <div class="error-actions">
      <a href="/en/" class="btn-primary">Back to home</a>
      <a href="/en/blog/" class="btn-secondary">Browse blog</a>
    </div>
  </section>
</Layout>

<style>
  .error-page {
    max-width: 36rem;
    margin: 4rem auto;
    text-align: center;
    padding: 0 1rem;
  }

  .error-code {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1;
    color: var(--brand);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .error-lead {
    color: var(--muted);
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
