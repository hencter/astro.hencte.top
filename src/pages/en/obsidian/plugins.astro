---
import { getEntry, render } from "astro:content";
import Layout from "../../../layouts/BaseLayout.astro";
import Banner from "../../../components/Banner.astro";
import { sectionImage } from "../../../lib/section-images";

const entry = await getEntry("connect", "en/obsidian/plugins");
if (!entry) {
  throw new Error("Missing connect content: en/obsidian/plugins");
}

const page = entry.data;
const hero = page.hero;
const { Content } = await render(entry);
const bannerActions = [hero?.actions?.primary, hero?.actions?.secondary].filter(
  (a): a is { label: string; href: string } => Boolean(a?.label && a?.href),
);
const bannerImage = sectionImage("obsidian");
---

<Layout
  title={page.title}
  description={page.description}
  locale="en-US"
  canonicalPath="/en/obsidian/plugins"
  alternates={{
    "zh-CN": "/obsidian/plugins",
    "en-US": "/en/obsidian/plugins",
    "x-default": "/obsidian/plugins",
  }}
  keywords={page.keywords ?? []}
>
  <Banner
    variant="page"
    compact
    kicker={hero?.badge}
    title={hero?.headline ?? page.title}
    subtitle={hero?.subtitle}
    image={bannerImage}
    actions={bannerActions}
    actionStyle="text"
  />

  <section class="section">
    <div class="post-prose">
      <Content />
    </div>
  </section>
</Layout>
