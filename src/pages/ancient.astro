---
import { getCollection } from "astro:content";
import BlogSectionLayout from "../layouts/BlogSectionLayout.astro";

const allEntries = await getCollection("blog");
const posts = allEntries
  .filter((entry) => !entry.data.draft)
  .filter((entry) => (entry.data.section || entry.id.split("/")[0]) === "ancient")
  .sort((a, b) => {
    const aTime = a.data.date ? a.data.date.getTime() : 0;
    const bTime = b.data.date ? b.data.date.getTime() : 0;
    return bTime - aTime;
  })
  .map((entry) => ({
    title: entry.data.title,
    href: `/${entry.id}`,
    date: entry.data.date,
    description: entry.data.description,
    tags: entry.data.tags,
  }));
---

<BlogSectionLayout
  title="古文"
  description="收录古籍片段与古文排版实验：Heti 中西文混排、标点挤压，以及公历 + 农历日期展示。"
  canonicalPath="/ancient"
  badge="古文"
  sectionKey="ancient"
  posts={posts}
>
  <p>
    本栏目用于<strong>阅读体验实验</strong>——在保留原文的基础上，尝试更适合屏幕阅读的中文排版。
  </p>
  <ul class="detail-list">
    <li>正文启用 Heti，自动优化中西文间距与标点挤压</li>
    <li>文章页显示公历与农历日期，便于对照阅读</li>
    <li>竖排/全屏等版式可在单篇正文中切换（若已配置）</li>
  </ul>
  <p>
    技术类文章见 <a href="/tech">技术</a>，日常记录见 <a href="/log">日志</a>，全部文章见 <a href="/blog">博客首页</a>。
  </p>
</BlogSectionLayout>
