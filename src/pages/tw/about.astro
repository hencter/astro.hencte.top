---
import Layout from "../../layouts/BaseLayout.astro";
import AboutSections from "../../components/connect/AboutSections.astro";
import { getPageAlternates } from "../../lib/i18n";
import { getAboutStrings } from "../../lib/ui-strings";
import { getMirroredConnect } from "../../lib/connect-mirror";

const page = await getMirroredConnect("about", "tw");
const locale = "zh-TW";
---

<Layout
  title={page.title}
  description={page.description}
  locale={locale}
  canonicalPath="/tw/about"
  connectPage="about"
  alternates={getPageAlternates("about")}
  keywords={page.keywords ?? []}
>
  <AboutSections page={page} locale={locale} strings={getAboutStrings(locale)} />
</Layout>
