---
import Layout from "../../../layouts/BaseLayout.astro";
import BlogIndexView from "../../../components/blog/BlogIndexView.astro";
import { getPageAlternates } from "../../../lib/i18n";
import { getMirroredConnect } from "../../../lib/connect-mirror";
import { getBlogIndexData } from "../../../lib/blog-helpers";

const locale = "zh-TW";
const page = await getMirroredConnect("blog", "tw");
const sectionMeta = page.sections ?? [];
const data = await getBlogIndexData(sectionMeta, locale);
---

<Layout
  title={page.title}
  description={page.description}
  locale={locale}
  canonicalPath="/tw/blog"
  connectPage="blog"
  alternates={getPageAlternates("blog")}
  keywords={page.keywords ?? []}
>
  <BlogIndexView
    locale={locale}
    page={page}
    sectionMeta={sectionMeta}
    data={data}
    statsLabel="公開文章"
    sectionsTitle="欄目"
    postsUnit="篇文章"
  />
</Layout>
