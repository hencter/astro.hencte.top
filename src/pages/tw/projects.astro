---
import ConnectShell from "../../components/connect/ConnectShell.astro";
import ProjectsSections from "../../components/connect/ProjectsSections.astro";
import { getConnectPageData } from "../../lib/connect-page";
import { getProjectsStrings } from "../../lib/ui-strings";

const locale = "zh-TW";
const page = await getConnectPageData("projects", locale);
---

<ConnectShell page={page} locale={locale} connectPage="projects">
  <ProjectsSections page={page} locale={locale} strings={getProjectsStrings(locale)} />
</ConnectShell>
