---
import Layout from "../../layouts/BaseLayout.astro";
import ProjectsSections from "../../components/connect/ProjectsSections.astro";
import { getPageAlternates } from "../../lib/i18n";
import { getProjectsStrings } from "../../lib/ui-strings";
import { getMirroredConnect } from "../../lib/connect-mirror";

const page = await getMirroredConnect("projects", "tw");
const locale = "zh-TW";
---

<Layout
  title={page.title}
  description={page.description}
  locale={locale}
  canonicalPath="/tw/projects"
  connectPage="projects"
  alternates={getPageAlternates("projects")}
  keywords={page.keywords ?? []}
>
  <ProjectsSections page={page} locale={locale} strings={getProjectsStrings(locale)} />
</Layout>
