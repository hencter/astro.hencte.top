---
import Layout from "../../layouts/BaseLayout.astro";
import HomeSections from "../../components/connect/HomeSections.astro";
import { getPageAlternates } from "../../lib/i18n";
import { getHomeStrings } from "../../lib/ui-strings";
import { getMirroredConnect } from "../../lib/connect-mirror";
import { getLatestPosts, getHomeNovels } from "../../lib/blog-helpers";

const home = await getMirroredConnect("home", "tw");
const locale = "zh-TW";
const latestPosts = await getLatestPosts(6, locale);
const homeNovels = await getHomeNovels(locale);
---

<Layout
  title={home.title}
  description={home.description}
  locale={locale}
  canonicalPath="/tw"
  connectPage="home"
  alternates={getPageAlternates("home")}
  keywords={home.keywords ?? []}
>
  <HomeSections
    home={home}
    locale={locale}
    latestPosts={latestPosts}
    homeNovels={homeNovels}
    strings={getHomeStrings(locale)}
  />
</Layout>
