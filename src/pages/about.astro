---
import { getEntry } from "astro:content";
import Layout from "../layouts/BaseLayout.astro";
import AboutSections from "../components/connect/AboutSections.astro";
import { getPageAlternates } from "../lib/i18n";
import { getAboutStrings } from "../lib/ui-strings";

const aboutEntry = await getEntry("connect", "zh/about");
if (!aboutEntry) {
  throw new Error("Missing connect content: zh/about");
}

const page = aboutEntry.data;
const locale = "zh-CN";
---

<Layout
  title={page.title}
  description={page.description}
  locale={locale}
  canonicalPath="/about"
  connectPage="about"
  alternates={getPageAlternates("about")}
  keywords={page.keywords ?? []}
>
  <AboutSections page={page} locale={locale} strings={getAboutStrings(locale)} />
</Layout>
