---
import ConnectShell from "../components/connect/ConnectShell.astro";
import AboutSections from "../components/connect/AboutSections.astro";
import { getConnectPageData } from "../lib/connect-page";
import { getAboutStrings } from "../lib/ui-strings";

const locale = "zh-CN";
const page = await getConnectPageData("about", locale);
---

<ConnectShell page={page} locale={locale} connectPage="about" faqJsonLd>
  <AboutSections page={page} locale={locale} strings={getAboutStrings(locale)} />
</ConnectShell>
