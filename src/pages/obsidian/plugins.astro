---
import { getEntry, render } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";

const entry = await getEntry("connect", "zh/obsidian/plugins");
if (!entry) {
  throw new Error("Missing connect content: zh/obsidian/plugins");
}

const page = entry.data;
const hero = page.hero;
const { Content } = await render(entry);
---

<Layout
  title={page.title}
  description={page.description}
  locale="zh-CN"
  canonicalPath="/obsidian/plugins"
  alternates={{
    "zh-CN": "/obsidian/plugins",
    "en-US": "/en/obsidian/plugins",
    "x-default": "/obsidian/plugins",
  }}
  keywords={page.keywords ?? []}
>
  <Hero compact badge={hero?.badge} headline={hero?.headline} subtitle={hero?.subtitle} actions={hero?.actions} />

  <section class="section">
    <div class="post-prose">
      <Content />
    </div>
  </section>
</Layout>
