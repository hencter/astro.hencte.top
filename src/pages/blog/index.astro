---
import { getEntry } from "astro:content";
import Layout from "../../layouts/BaseLayout.astro";
import BlogIndexView from "../../components/blog/BlogIndexView.astro";
import { getPageAlternates } from "../../lib/i18n";
import { getBlogIndexData } from "../../lib/blog-helpers";

const blogEntry = await getEntry("connect", "zh/blog");
if (!blogEntry) {
  throw new Error("Missing connect content: zh/blog");
}

const page = blogEntry.data;
const sectionMeta = page.sections ?? [];
const data = await getBlogIndexData(sectionMeta, "zh-CN");
---

<Layout
  title={page.title}
  description={page.description}
  locale="zh-CN"
  canonicalPath="/blog"
  connectPage="blog"
  alternates={getPageAlternates("blog")}
  keywords={page.keywords ?? []}
>
  <BlogIndexView
    locale="zh-CN"
    page={page}
    sectionMeta={sectionMeta}
    data={data}
    statsLabel="公开文章"
    sectionsTitle="栏目"
    postsUnit="篇文章"
  />
</Layout>
