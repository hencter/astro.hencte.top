---
import type { CollectionEntry } from "astro:content";
import type { SiteLocale } from "../../lib/i18n";
import NovelLayout from "../../layouts/NovelLayout.astro";
import NovelLandingPage from "../../layouts/NovelLandingPage.astro";
import NovelIndexPage from "../../layouts/NovelIndexPage.astro";
import { buildNovelPageContext, getNovelStaticPaths } from "../../lib/novel-page";

export async function getStaticPaths() {
  return getNovelStaticPaths("zh-CN");
}

const slugParam = Astro.params.slug as string | undefined;
const { entry, novelLocale } = Astro.props as {
  entry: CollectionEntry<"novel">;
  novelLocale: SiteLocale;
};
const ctx = await buildNovelPageContext(novelLocale, entry, slugParam);
---

{ctx.chapterCtx ? (
  <NovelLayout
    locale={ctx.locale}
    title={ctx.displayData.title as string}
    description={ctx.displayData.description as string | undefined}
    novelTitle={ctx.chapterCtx.novelTitle}
    novelHref={ctx.chapterCtx.novelSlug ? `/novel/${ctx.chapterCtx.novelSlug}` : "/novel/"}
    chapters={ctx.chapterCtx.chapters}
    prevChapter={ctx.chapterCtx.prevChapter}
    nextChapter={ctx.chapterCtx.nextChapter}
    novelSlug={ctx.chapterCtx.novelSlug}
    chapterSlug={ctx.slug!}
    contentOwnTitle={ctx.chapterCtx.contentOwnTitle}
    languageLinks={ctx.languageLinks}
    chapterImage={ctx.displayData.chapterImage as string | undefined}
    imageAlt={ctx.displayData.imageAlt as string | undefined}
    Content={ctx.Content}
    html={ctx.html}
  />
) : ctx.landingCtx ? (
  <NovelLandingPage
    locale={ctx.locale}
    title={ctx.landingCtx.novelTitle}
    description={ctx.landingCtx.novelDescription}
    chapters={ctx.landingCtx.chapters}
    novelSlug={ctx.landingCtx.novelSlug}
    comingSoon={ctx.landingCtx.comingSoon}
    cover={ctx.displayData.cover as string | undefined}
    imageAlt={ctx.displayData.imageAlt as string | undefined}
    languageLinks={ctx.languageLinks}
    chapterImage={ctx.displayData.chapterImage as string | undefined}
    imageAlt={ctx.displayData.imageAlt as string | undefined}
    Content={ctx.Content}
    html={ctx.html}
  />
) : (
  <NovelIndexPage locale={ctx.locale} novels={ctx.indexNovels} languageLinks={ctx.languageLinks} />
)}
