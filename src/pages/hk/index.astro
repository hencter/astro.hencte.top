---
import ConnectShell from "../../components/connect/ConnectShell.astro";
import HomeSections from "../../components/connect/HomeSections.astro";
import { getConnectPageData } from "../../lib/connect-page";
import { getHomeStrings } from "../../lib/ui-strings";
import { getLatestPosts } from "../../lib/blog-helpers";

const locale = "zh-HK";
const home = await getConnectPageData("home", locale);
const latestPosts = await getLatestPosts(6, locale);
---

<ConnectShell page={home} locale={locale} connectPage="home">
  <HomeSections
    home={home}
    locale={locale}
    latestPosts={latestPosts}
    strings={getHomeStrings(locale)}
  />
</ConnectShell>
