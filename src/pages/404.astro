---
import Layout from "../layouts/BaseLayout.astro";
import { getPageAlternates } from "../lib/i18n";

const locale = "zh-CN";
---

<Layout
  title="页面未找到 | 亦幸小阁"
  description="您访问的页面不存在或已迁移。"
  locale={locale}
  canonicalPath="/404"
  connectPage="home"
  alternates={getPageAlternates("home")}
  robots="noindex"
>
  <section class="error-page">
    <p class="error-code">404</p>
    <h1>页面未找到</h1>
    <p class="error-lead">您访问的链接可能已失效、已迁移，或从未存在过。</p>
    <div class="error-actions">
      <a href="/" class="btn-primary">返回首页</a>
      <a href="/blog/" class="btn-secondary">浏览博客</a>
    </div>
  </section>
</Layout>

<style>
  .error-page {
    max-width: 36rem;
    margin: 4rem auto;
    text-align: center;
    padding: 0 1rem;
  }

  .error-code {
    font-size: 4rem;
    font-weight: 800;
    line-height: 1;
    color: var(--brand);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .error-lead {
    color: var(--muted);
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
