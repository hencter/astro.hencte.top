---
import ConnectShell from "../components/connect/ConnectShell.astro";
import FriendLinksSections from "../components/connect/FriendLinksSections.astro";
import { getConnectPageData } from "../lib/connect-page";
import { getLinksStrings } from "../lib/ui-strings";

const locale = "zh-CN";
const page = await getConnectPageData("links", locale);
---

<ConnectShell page={page} locale={locale} connectPage="links">
  <FriendLinksSections page={page} locale={locale} strings={getLinksStrings(locale)} />
</ConnectShell>
