---
import { getEntry } from "astro:content";
import Layout from "../layouts/BaseLayout.astro";
import HomeSections from "../components/connect/HomeSections.astro";
import { getPageAlternates } from "../lib/i18n";
import { getHomeStrings } from "../lib/ui-strings";
import { getLatestPosts, getHomeNovels } from "../lib/blog-helpers";

const homeEntry = await getEntry("connect", "zh/home");
if (!homeEntry) {
  throw new Error("Missing connect content: zh/home");
}

const home = homeEntry.data;
const latestPosts = await getLatestPosts();
const homeNovels = await getHomeNovels("zh-CN");
const locale = "zh-CN";
---

<Layout
  title={home.title}
  description={home.description}
  locale={locale}
  canonicalPath="/"
  connectPage="home"
  alternates={getPageAlternates("home")}
  keywords={home.keywords ?? []}
>
  <HomeSections
    home={home}
    locale={locale}
    latestPosts={latestPosts}
    homeNovels={homeNovels}
    strings={getHomeStrings(locale)}
  />
</Layout>
