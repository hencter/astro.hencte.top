---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import AncientPostLayout from "../layouts/FullscreenAncientLayout.astro";
import BlogSectionLayout from "../layouts/BlogSectionLayout.astro";
import JsonLD from "../components/JsonLD.astro";

export async function getStaticPaths() {
  const allowedSections = new Set(["log", "tech", "ancient", "posts"]);
  const inferSection = (entry: { id: string; data: { section?: string } }) =>
    entry.data.section || entry.id.split("/")[0] || "blog";
  const isIndexPage = (entry: { data: { legacyPath?: string } }) =>
    Boolean(entry.data.legacyPath?.endsWith("_index.md"));

  const allEntries = await getCollection("blog");
  const publicEntries = allEntries
    .filter((entry) => !entry.data.draft)
    .filter((entry) => allowedSections.has(inferSection(entry)));

  const indexEntries = publicEntries.filter((entry) => isIndexPage(entry));
  const postEntries = publicEntries.filter((entry) => !isIndexPage(entry));

  const childPostCount = new Map<string, number>();
  for (const indexEntry of indexEntries) {
    const prefix = `${indexEntry.id}/`;
    childPostCount.set(
      indexEntry.id,
      postEntries.filter((entry) => entry.id.startsWith(prefix)).length
    );
  }

  const posts = publicEntries.filter((entry) => {
    if (!isIndexPage(entry)) {
      return true;
    }

    if (entry.id.split("/").length <= 1) {
      return true;
    }

    return (childPostCount.get(entry.id) || 0) > 0;
  });

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const allowedSections = new Set(["log", "tech", "ancient", "posts"]);

function inferSection(entry: { id: string; data: { section?: string } }): string {
  return entry.data.section || entry.id.split("/")[0] || "blog";
}

function isIndexPage(entry: { data: { legacyPath?: string } }): boolean {
  return Boolean(entry.data.legacyPath?.endsWith("_index.md"));
}

const { post } = Astro.props as { post: CollectionEntry<"blog"> };
const { Content, headings } = await render(post);

const hasMath = post.data.math || (post.body ?? "").includes("$$");
const hasMermaid = (post.body ?? "").includes("```mermaid");

const sectionKey = inferSection(post);
const isAncient = sectionKey === "ancient";
const isSectionLanding = isIndexPage(post);

const sectionLabels: Record<string, string> = {
  log: "日志",
  tech: "技术",
  ancient: "古文",
  posts: "文章",
};

// ---- 相关文章计算（内容互链，仅对非 ancient、非栏目落地页的文章页生效）----
let relatedPosts: {
  id: string;
  title: string;
  date?: Date;
  excerpt?: string;
}[] = [];

if (!isAncient && !isSectionLanding) {
  const relatedSectionAllow = new Set(["log", "tech", "posts"]);
  const truncateExcerpt = (text: string, max = 80): string =>
    text.length > max ? `${text.slice(0, max)}…` : text;

  const allEntries = await getCollection("blog");
  const currentTags = new Set(post.data.tags || []);
  const currentCategories = new Set(post.data.categories || []);

  const relatedCandidates = allEntries.filter((entry) => {
    if (entry.id === post.id) return false;
    if (entry.data.draft) return false;
    if (isIndexPage(entry)) return false;
    return relatedSectionAllow.has(inferSection(entry));
  });

  const byDateDesc = (a: { data: { date?: Date } }, b: { data: { date?: Date } }): number => {
    const aTime = a.data.date ? a.data.date.getTime() : 0;
    const bTime = b.data.date ? b.data.date.getTime() : 0;
    return bTime - aTime;
  };

  // 打分：共享 tag ×3 + 共享 category ×2 + 同 section +1，取分 >0 的前 3 篇
  const scored = relatedCandidates
    .map((entry) => {
      const sharedTags = (entry.data.tags || []).filter((tag) => currentTags.has(tag)).length;
      const sharedCategories = (entry.data.categories || []).filter((category) =>
        currentCategories.has(category)
      ).length;
      const score = sharedTags * 3 + sharedCategories * 2 + (inferSection(entry) === sectionKey ? 1 : 0);
      return { entry, score };
    })
    .filter((item) => item.score > 0)
    .sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      return byDateDesc(a.entry, b.entry);
    })
    .slice(0, 3);

  const picked = scored.map((item) => item.entry);

  // 不足 3 篇时，用同 section 最新文章补足（去重）
  if (picked.length < 3) {
    const pickedIds = new Set(picked.map((entry) => entry.id));
    const fallback = relatedCandidates
      .filter((entry) => inferSection(entry) === sectionKey && !pickedIds.has(entry.id))
      .sort(byDateDesc)
      .slice(0, 3 - picked.length);
    picked.push(...fallback);
  }

  relatedPosts = picked.map((entry) => ({
    id: entry.id,
    title: entry.data.title,
    date: entry.data.date,
    excerpt: entry.data.description ? truncateExcerpt(entry.data.description) : undefined,
  }));
}

const wordCount = (post.body ?? "").replace(/\s+/g, "").length;
const readingMinutes = Math.max(1, Math.round(wordCount / 900));

function formatDate(date?: Date): string {
  if (!date) {
    return "日期待补充";
  }
  return date.toLocaleDateString("zh-CN", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}

const canonicalPath = `/${post.id}`;
const seoKeywords = [
  ...(post.data.tags || []),
  ...(post.data.categories || []),
  "亦幸小阁",
  "个人博客",
];

let landingSections: { title: string; href: string; description?: string; count: number }[] = [];
let landingPosts: { title: string; href: string; date?: Date; description?: string; tags?: string[] }[] = [];

if (isSectionLanding && !isAncient) {
  const allEntries = await getCollection("blog");
  const publicEntries = allEntries
    .filter((entry) => !entry.data.draft)
    .filter((entry) => allowedSections.has(inferSection(entry)));

  const prefix = post.id;
  const prefixDepth = prefix.split("/").length;
  const descendants = publicEntries.filter((entry) => entry.id.startsWith(`${prefix}/`));

  const immediateIndexPages = descendants
    .filter((entry) => isIndexPage(entry))
    .filter((entry) => entry.id.split("/").length === prefixDepth + 1)
    .sort((a, b) => a.data.title.localeCompare(b.data.title, "zh-CN"));

  landingSections = immediateIndexPages.map((entry) => {
    const childCount = descendants
      .filter((child) => child.id.startsWith(`${entry.id}/`))
      .filter((child) => !isIndexPage(child)).length;

    return {
      title: entry.data.title,
      href: `/${entry.id}`,
      description: entry.data.description,
      count: childCount,
    };
  });

  landingPosts = descendants
    .filter((entry) => !isIndexPage(entry))
    .sort((a, b) => {
      const aTime = a.data.date ? a.data.date.getTime() : 0;
      const bTime = b.data.date ? b.data.date.getTime() : 0;
      return bTime - aTime;
    })
    .map((entry) => ({
      title: entry.data.title,
      href: `/${entry.id}`,
      date: entry.data.date,
      description: entry.data.description,
      tags: entry.data.tags,
    }));
}
---

{
  isAncient ? (
    <AncientPostLayout
      title={post.data.title}
      description={post.data.description}
      layout={"vertical"}
    >
      <Content />
    </AncientPostLayout>
  ) : isSectionLanding ? (
    <BlogSectionLayout
      title={post.data.title}
      description={post.data.description}
      canonicalPath={canonicalPath}
      badge={`Blog / ${sectionLabels[sectionKey] || sectionKey}`}
      sections={landingSections}
      posts={landingPosts}
    >
      <Content />
    </BlogSectionLayout>
  ) : (
    <BaseLayout
      title={`${post.data.title} | 亦幸小阁`}
      description={post.data.description || `${post.data.title} - 博客文章`}
      locale="zh-CN"
      canonicalPath={canonicalPath}
      keywords={seoKeywords}
    >
      <JsonLD
        type="Article"
        article={post}
        pageTitle={post.data.title}
        pageDescription={post.data.description}
        canonicalPath={canonicalPath}
        datePublished={post.data.date}
        dateModified={post.data.lastmod ? new Date(post.data.lastmod) : undefined}
        tags={post.data.tags}
      />
      <JsonLD
        type="BreadcrumbList"
        breadcrumbs={[
          { name: "首页", url: "/" },
          { name: sectionLabels[sectionKey] || sectionKey, url: `/${sectionKey}` },
          { name: post.data.title, url: canonicalPath },
        ]}
      />
      <section class="section post-shell">
        <header class="post-header">
          <nav class="breadcrumb" aria-label="面包屑">
            <ol>
              <li><a href="/">首页</a></li>
              <li aria-hidden="true" class="breadcrumb-separator">›</li>
              <li><a href={`/${sectionKey}`}>{sectionLabels[sectionKey] || sectionKey}</a></li>
              <li aria-hidden="true" class="breadcrumb-separator">›</li>
              <li class="breadcrumb-current" aria-current="page">{post.data.title}</li>
            </ol>
          </nav>
          <p class="card-kicker">{post.data.section || "blog"}</p>
          <h1>{post.data.title}</h1>
          <div class="post-meta-line">
            <span>{formatDate(post.data.date)}</span>
            <span>约 {readingMinutes} 分钟阅读</span>
          </div>

          {(post.data.tags.length > 0 || post.data.categories.length > 0) && (
            <ul class="chip-list">
              {post.data.categories.map((category) => <li>{category}</li>)}
              {post.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          )}
        </header>

        {headings.length > 0 && (
          <aside class="post-toc">
            <h2>目录</h2>
            <ul>
              {headings.filter((item) => item.depth <= 3).map((item) => (
                <li>
                  <a href={`#${item.slug}`}>{item.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}

        <div class="post-prose">
          <Content />
        </div>

        {relatedPosts.length > 0 && (
          <aside class="related-posts reveal-on-scroll">
            <h2 class="section-title related-title">相关文章</h2>
            <div class="related-grid">
              {relatedPosts.map((related) => (
                <article class="related-card">
                  <h3 class="related-card-title">
                    <a href={`/${related.id}`} data-astro-prefetch="hover">{related.title}</a>
                  </h3>
                  <p class="post-meta-line related-card-meta">{formatDate(related.date)}</p>
                  {related.excerpt && <p class="related-card-excerpt">{related.excerpt}</p>}
                </article>
              ))}
            </div>
          </aside>
        )}
      </section>
      {hasMath && (
        <>
          <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
          <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js">
          </script>
          <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js">
          </script>
          <script defer>
            document.addEventListener("DOMContentLoaded", () => { renderMathInElement(document.body, { delimiters: [{ left: "\\[", right: "\\]", display: true }, { left: "\\(", right: "\\)", display: false }, { left: "$$", right: "$$", display: true }, { left: "$", right: "$", display: false }] }) })
          </script>
        </>
      )}
      {hasMermaid && (
        <script type="module">
          import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
          mermaid.initialize({ startOnLoad: true, theme: "default", securityLevel: "loose" })
        </script>
      )}
    </BaseLayout>
  )
}
