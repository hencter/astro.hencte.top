---
/**
 * CtaBanner — closing call-to-action (at most one per page).
 * Implemented on Banner variant="cta"; split layout uses aside slot (QR).
 */
import Banner from "./Banner.astro";

interface CtaAction {
  label: string;
  href: string;
}

interface Props {
  title: string;
  text?: string;
  primary?: CtaAction;
  secondary?: CtaAction;
  variant?: "default" | "split";
  image?: string;
  imageAlt?: string;
}

const { title, text, primary, secondary, variant = "default", image, imageAlt } = Astro.props;
const isSplit = variant === "split";
const actions = [primary, secondary].filter((a): a is CtaAction => Boolean(a?.label && a?.href));
---

<Banner
  variant="cta"
  title={title}
  subtitle={text}
  split={isSplit}
  image={image}
  imageAlt={imageAlt}
  actions={actions}
  actionStyle="text"
>
  <slot slot="aside" />
</Banner>
