---
/**
 * LocaleSelect — native <select> styled to the site design tokens
 * (visual language similar to a shadcn/ui select, zero dependencies).
 *
 * Works in every shell context by falling back across token systems:
 *   NovelLayout      -> --nv-*      (chapter pages, standalone CSS)
 *   Novel landing/index -> --bg/--surface/--line/--ink/--brand (standalone)
 *   BaseLayout pages -> global.css tokens (--line/--surface/--ink-* family)
 *
 * Navigation uses plain window.location on change (full page load), so
 * novel DRM / reading scripts are untouched. A <noscript> fallback keeps
 * real per-locale alternate links for crawlers and no-JS users.
 */
interface LinkItem {
  locale?: string;
  href: string;
  label: string;
  current: boolean;
}

interface Props {
  links: LinkItem[];
  label?: string;
}

const { links, label = "语言 / Language" } = Astro.props;
const hasLinks = links.length > 0;
---

{
  hasLinks && (
    <div class="locale-select">
      <select
        class="locale-select__control"
        aria-label={label}
        title={label}
        data-locale-nav
      >
        {links.map((link) => (
          <option value={link.href} selected={link.current}>
            {link.label}
          </option>
        ))}
      </select>
      <svg
        class="locale-select__chevron"
        viewBox="0 0 16 16"
        width="14"
        height="14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m4 6 4 4 4-4" />
      </svg>
      <noscript>
        <ul class="locale-select__fallback">
          {links.map((link) => (
            <li>
              {
                link.current ? (
                  <span aria-current="true">{link.label}</span>
                ) : (
                  <a href={link.href} hreflang={link.locale} rel="alternate">
                    {link.label}
                  </a>
                )
              }
            </li>
          ))}
        </ul>
      </noscript>
    </div>
  )
}

<script>
  // Bind once per element; re-runs are safe across View Transitions.
  function bindLocaleSelects() {
    document.querySelectorAll('select[data-locale-nav]').forEach(function (sel) {
      if (sel.dataset.localeBound === '1') return;
      sel.dataset.localeBound = '1';
      sel.addEventListener('change', function () {
        if (sel.value) window.location.assign(sel.value);
      });
    });
  }
  if (typeof window !== 'undefined') {
    document.addEventListener('astro:page-load', bindLocaleSelects);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindLocaleSelects);
    } else {
      bindLocaleSelects();
    }
  }
</script>

<style>
  .locale-select {
    --ls-border: var(--nv-border, var(--line, #d8cdba));
    --ls-bg: var(--nv-control-bg, var(--surface, #fffcf5));
    --ls-ink: var(--nv-ink, var(--ink, var(--ink-700, #19150f)));
    --ls-brand: var(--nv-brand, var(--brand, #b8792c));
    --ls-muted: var(--nv-ink-muted, var(--muted, var(--ink-500, #5f5548)));
    position: relative;
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .locale-select__control {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    min-width: 6.4rem;
    max-width: 11.5rem;
    padding: 0.42rem 1.75rem 0.42rem 0.75rem;
    border: 1px solid var(--ls-border);
    border-radius: var(--radius-md, 0.5rem);
    background: var(--ls-bg);
    color: var(--ls-ink);
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    text-overflow: ellipsis;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .locale-select__control:hover {
    border-color: var(--ls-brand);
  }

  .locale-select__control:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--ls-brand) 45%, transparent);
    outline-offset: 2px;
  }

  .locale-select__control option {
    background: var(--ls-bg);
    color: var(--ls-ink);
  }

  .locale-select__chevron {
    position: absolute;
    right: 0.6rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--ls-muted);
  }

  .locale-select__fallback {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.7rem;
    margin: 0.25rem 0 0;
    padding: 0;
    font-size: 0.8rem;
  }

  .locale-select__fallback a {
    color: var(--ls-brand);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .locale-select__control {
      min-width: 4.6rem;
      max-width: 8rem;
    }
  }
</style>
