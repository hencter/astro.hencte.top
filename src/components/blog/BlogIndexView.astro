---
import type { SiteLocale } from "../../lib/i18n";
import {
  type BlogIndexData,
  type BlogIndexSection,
  extractSummary,
  formatBlogDate,
} from "../../lib/blog-helpers";
import Banner from "../Banner.astro";
import EditorialListItem from "../EditorialListItem.astro";
import { sectionImage } from "../../lib/section-images";

interface Props {
  locale: SiteLocale;
  page: {
    hero?: {
      badge?: string;
      headline?: string;
      subtitle?: string;
      actions?: {
        primary?: { label: string; href: string };
        secondary?: { label: string; href: string };
      };
    };
    latestTitle?: string;
  };
  sectionMeta: BlogIndexSection[];
  data: BlogIndexData;
  statsLabel: string;
  sectionsTitle: string;
  postsUnit: string;
}

const { locale, page, sectionMeta, data, statsLabel, sectionsTitle, postsUnit } = Astro.props;
const { posts, novelCount, countsBySection, latestPosts, sectionLabels } = data;
const pendingDate =
  locale === "en-US" ? "Date pending" : locale === "zh-TW" ? "日期待補充" : locale === "zh-HK" ? "日期待補充" : "日期待补充";
const summaryFallback =
  locale === "en-US"
    ? "No summary yet — open the post to read more."
    : locale === "zh-TW"
      ? "暫無摘要，點擊進入查看全文。"
      : locale === "zh-HK"
        ? "暫無摘要，點擊進入查看全文。"
        : "暂无摘要，点击进入查看全文。";

const heroActions = [page.hero?.actions?.primary, page.hero?.actions?.secondary].filter(
  (a): a is { label: string; href: string } => Boolean(a?.label && a?.href),
);
const bannerImage = sectionImage("blog");
---

<Banner
  variant="page"
  compact
  kicker={page.hero?.badge}
  title={page.hero?.headline ?? (locale === "en-US" ? "Blog" : "博客")}
  subtitle={page.hero?.subtitle}
  image={bannerImage}
  actions={heroActions}
  actionStyle="text"
  prefetch
/>

<section class="section reveal-on-scroll">
  <div class="blog-stats">
    <p>
      {statsLabel} <strong>{posts.length + novelCount}</strong>
      {locale === "en-US" ? "" : " 篇"}
    </p>
    {sectionMeta.map((item) => (
      <p>
        {item.label} <strong>{countsBySection[item.key]}</strong>
        {locale === "en-US" ? "" : " 篇"}
      </p>
    ))}
  </div>

  <div class="section-block">
    <h2 class="section-title">{sectionsTitle}</h2>
    <div class="post-list">
      {
        sectionMeta.map((item) => (
          <EditorialListItem
            title={item.label}
            href={item.href}
            description={item.description}
            date={`${countsBySection[item.key]} ${postsUnit}`}
            prefetch
            stretched
          />
        ))
      }
    </div>
  </div>

  <div class="section-block">
    <h2 class="section-title">{page.latestTitle ?? (locale === "en-US" ? "Latest posts" : "最新文章")}</h2>
    <div class="post-list">
      {
        latestPosts.slice(0, 8).map((post) => {
          const label = sectionLabels[post.sectionKey] || post.sectionKey;
          return (
            <EditorialListItem
              kicker={label}
              title={post.title}
              href={`/${post.id}`}
              date={formatBlogDate(post.date, locale, pendingDate)}
              description={extractSummary(post.description, post.body, summaryFallback)}
              tags={post.tags}
              maxTags={4}
              prefetch
              stretched
            />
          );
        })
      }
    </div>
  </div>
</section>
