---
/**
 * Hero — thin compatibility shim over Banner (page variant).
 * Prefer importing Banner directly for new section hubs.
 */
import Banner from "./Banner.astro";

interface HeroAction {
  label: string;
  href: string;
}

interface Props {
  badge?: string;
  headline?: string;
  subtitle?: string;
  compact?: boolean;
  id?: string;
  actions?: { primary?: HeroAction; secondary?: HeroAction };
  prefetch?: boolean;
  image?: string;
  imageAlt?: string;
}

const { badge, headline, subtitle, compact, id, actions, prefetch = false, image, imageAlt } = Astro.props;

const bannerActions = [actions?.primary, actions?.secondary].filter(
  (a): a is HeroAction => Boolean(a?.label && a?.href),
);
---

<Banner
  variant="page"
  title={headline ?? ""}
  subtitle={subtitle}
  kicker={badge}
  compact={compact}
  id={id}
  image={image}
  imageAlt={imageAlt}
  actions={bannerActions}
  actionStyle="button"
  prefetch={prefetch}
>
  <slot name="before" slot="before" />
  <slot />
</Banner>
