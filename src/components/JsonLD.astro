---
import type { CollectionEntry } from "astro:content";
import {
  AUTHOR,
  ORGANIZATION,
  PERSON_SAME_AS,
  SITE_FAQS,
  SITE_URL,
} from "../lib/geo-site";

interface BookMeta {
  title: string;
  description?: string;
  slug: string;
  chapterCount?: number;
  genre?: string[];
  alternateName?: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  type: "Organization" | "WebSite" | "Article" | "BreadcrumbList" | "Book" | "BookCollection" | "FAQPage";
  article?: CollectionEntry<"blog">;
  breadcrumbs?: { name: string; url: string }[];
  pageTitle?: string;
  pageDescription?: string;
  canonicalPath?: string;
  datePublished?: Date;
  dateModified?: Date;
  tags?: string[];
  inLanguage?: string;
  book?: BookMeta;
  books?: BookMeta[];
  faqs?: FaqItem[];
}

const {
  type,
  article,
  breadcrumbs = [],
  pageTitle,
  pageDescription,
  canonicalPath = "",
  datePublished,
  dateModified,
  tags = [],
  inLanguage = "zh-CN",
  book,
  books = [],
  faqs = SITE_FAQS,
} = Astro.props;

const siteUrl = SITE_URL;
const fullUrl = siteUrl + canonicalPath;

const personRef = {
  "@type": "Person",
  "@id": AUTHOR.personId,
  name: AUTHOR.name,
  alternateName: AUTHOR.alternateName,
  url: siteUrl,
};

const orgRef = {
  "@type": "Organization",
  "@id": ORGANIZATION.orgId,
  name: ORGANIZATION.name,
  url: ORGANIZATION.url,
  logo: {
    "@type": "ImageObject",
    url: ORGANIZATION.logo,
  },
};

let jsonLd: Record<string, unknown>;

if (type === "Organization") {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": AUTHOR.personId,
    name: AUTHOR.name,
    alternateName: AUTHOR.alternateName,
    url: siteUrl,
    image: `${siteUrl}/og-image.png`,
    email: AUTHOR.email,
    jobTitle: AUTHOR.jobTitle,
    sameAs: [...PERSON_SAME_AS],
    description: pageDescription || "TypeScript/Lua/Python 开发者，关注 AI、知识管理与产品实践。",
    knowsAbout: [
      "TypeScript",
      "Lua",
      "Python",
      "AI",
      "LLM",
      "Agent",
      "Obsidian",
      "Knowledge Management",
      "SEO",
      "GEO",
    ],
  };
} else if (type === "WebSite") {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    name: ORGANIZATION.name,
    url: siteUrl,
    description: pageDescription || "亦幸（Hencter Lew）的个人品牌站点：技术博客、项目展示与知识管理实践。",
    inLanguage: ["zh-CN", "zh-TW", "zh-HK", "en-US"],
    author: personRef,
    publisher: orgRef,
    about: personRef,
  };
} else if (type === "Article" && article) {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    "@id": `${fullUrl}#article`,
    headline: article.data.title,
    description: article.data.description || `${article.data.title} - 亦幸小阁`,
    author: {
      ...personRef,
      url: AUTHOR.aboutUrl,
      sameAs: [...PERSON_SAME_AS],
    },
    publisher: orgRef,
    image: article.data.images?.[0]
      ? new URL(article.data.images[0], siteUrl).toString()
      : `${siteUrl}/og-image.png`,
    datePublished: datePublished?.toISOString() || article.data.date?.toISOString(),
    dateModified: dateModified?.toISOString() || article.data.lastmod || article.data.date?.toISOString(),
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": fullUrl,
    },
    isPartOf: {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      name: ORGANIZATION.name,
      url: siteUrl,
    },
    keywords: (tags.length > 0 ? tags : article.data.tags || [])?.join(", "),
    inLanguage,
    wordCount: (article.body ?? "").replace(/\s+/g, "").length,
    copyrightHolder: personRef,
  };
} else if (type === "BreadcrumbList" && breadcrumbs.length > 0) {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((crumb, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: crumb.name,
      item: crumb.url.startsWith("http") ? crumb.url : siteUrl + crumb.url,
    })),
  };
} else if (type === "Book" && book) {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "Book",
    "@id": `${fullUrl}#book`,
    name: book.title,
    ...(book.alternateName ? { alternateName: book.alternateName } : {}),
    description: book.description || pageDescription,
    author: personRef,
    inLanguage,
    genre: book.genre?.length ? book.genre : ["Fiction"],
    url: fullUrl,
    ...(book.chapterCount
      ? { numberOfPages: book.chapterCount, abridged: false }
      : {}),
    isAccessibleForFree: true,
    copyrightNotice: "Original fiction by Hencter Lew. Not licensed for AI training or reproduction.",
  };
} else if (type === "BookCollection" && books.length > 0) {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: pageTitle || "亦幸小阁 · 原创小说",
    description:
      pageDescription ||
      "Bibliographic index of original fiction. Chapter text is reader-only and excluded from AI indexing.",
    itemListElement: books.map((b, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Book",
        name: b.title,
        ...(b.alternateName ? { alternateName: b.alternateName } : {}),
        description: b.description,
        url: `${siteUrl}/shelf/${b.slug}`,
        author: personRef,
        inLanguage,
        ...(b.chapterCount ? { numberOfPages: b.chapterCount } : {}),
      },
    })),
  };
} else if (type === "FAQPage" && faqs.length > 0) {
  jsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${fullUrl}#faq`,
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
} else {
  jsonLd = {};
}
---

{
  Object.keys(jsonLd).length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
