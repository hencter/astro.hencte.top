---
import type { SiteLocale } from "../../lib/i18n";
import Hero from "../Hero.astro";
import SectionHeading from "../SectionHeading.astro";

interface ProjectsData {
  hero?: {
    badge?: string;
    headline?: string;
    subtitle?: string;
    actions?: {
      primary?: { label: string; href: string };
      secondary?: { label: string; href: string };
    };
  };
  featuredProjects?: {
    stage?: string;
    title: string;
    description?: string;
    result?: string;
    tags: string[];
    url?: string;
    image?: string;
    imageAlt?: string;
  }[];
  timeline?: { phase: string; detail: string }[];
}

interface Props {
  page: ProjectsData;
  locale: SiteLocale;
  strings: {
    featuredTitle: string;
    featuredSubtitle: string;
    timelineTitle: string;
    timelineSubtitle: string;
    visitExternal: string;
    viewDetails: string;
  };
}

const { page, locale, strings } = Astro.props;
const hero = page.hero;
const projects = page.featuredProjects ?? [];
const timeline = page.timeline ?? [];
---

<Hero id="top" badge={hero?.badge} headline={hero?.headline} subtitle={hero?.subtitle} actions={hero?.actions} />

<section class="section reveal-on-scroll" id="featured">
  <SectionHeading title={strings.featuredTitle} subtitle={strings.featuredSubtitle} />
  {
    projects.length > 0 && (
      <article class="card-featured">
        <div class:list={["card-featured-visual", { "card-featured-visual--image": Boolean(projects[0].image) }]}>
          {projects[0].image ? (
            <img
              src={projects[0].image}
              alt={projects[0].imageAlt || projects[0].title}
              width="960"
              height="600"
              loading="eager"
              decoding="async"
            />
          ) : (
            <span aria-hidden="true">
              {projects[0].title?.includes("astro") || projects[0].title?.includes("站") || projects[0].title?.includes("site") ? "🛰" : projects[0].title?.includes("Agent") || projects[0].title?.includes("蜂群") || projects[0].title?.includes("Swarm") ? "🐝" : projects[0].title?.includes("知识") || projects[0].title?.includes("Obsidian") || projects[0].title?.includes("Knowledge") ? "🧠" : "✦"}
            </span>
          )}
        </div>
        <div class="card-featured-body">
          <p class="card-kicker">{projects[0].stage}</p>
          <h3>{projects[0].title}</h3>
          <p>{projects[0].description}</p>
          {projects[0].result && <p class="result-line">{projects[0].result}</p>}
          <ul class="chip-list">
            {projects[0].tags.map((tag) => <li>{tag}</li>)}
          </ul>
          {projects[0].url && (
            <p>
              <a class="btn-secondary" style="display:inline-flex;margin-top:0.5rem"
                href={projects[0].url}
                target={projects[0].url.startsWith("http") ? "_blank" : undefined}
                rel={projects[0].url.startsWith("http") ? "noreferrer" : undefined}
              >
                {projects[0].url.startsWith("http") ? strings.visitExternal : strings.viewDetails}
              </a>
            </p>
          )}
        </div>
      </article>
    )
  }
  {
    projects.length > 1 && (
      <div class="blog-list-grid" style="margin-top:1rem">
        {
          projects.slice(1).map((project) => (
            <article class="project-card">
              {project.image && (
                <figure class="project-card-thumb">
                  <img
                    src={project.image}
                    alt={project.imageAlt || project.title}
                    width="640"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
              <p class="card-kicker">{project.stage}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              {project.result && <p class="result-line">{project.result}</p>}
              <ul class="chip-list">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              {project.url && (
                <p>
                  <a
                    href={project.url}
                    target={project.url.startsWith("http") ? "_blank" : undefined}
                    rel={project.url.startsWith("http") ? "noreferrer" : undefined}
                  >
                    {project.url.startsWith("http") ? strings.visitExternal : strings.viewDetails}
                  </a>
                </p>
              )}
            </article>
          ))
        }
      </div>
    )
  }
</section>

<style>
  .project-card-thumb {
    margin: -0.15rem -0.15rem 0.75rem;
    border-radius: calc(var(--radius-lg) - 2px);
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: color-mix(in srgb, var(--surface) 88%, var(--brand) 12%);
  }

  .project-card-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<section class="section reveal-on-scroll">
  <SectionHeading title={strings.timelineTitle} subtitle={strings.timelineSubtitle} />
  <div class="timeline">
    {
      timeline.map((item) => (
        <article class="card-accent-stripe">
          <p class="card-kicker">{item.phase}</p>
          <p>{item.detail}</p>
        </article>
      ))
    }
  </div>
</section>
