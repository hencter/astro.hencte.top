---
import type { SiteLocale } from "../../lib/i18n";
import Banner from "../Banner.astro";
import Card from "../Card.astro";
import SectionHeading from "../SectionHeading.astro";
import { sectionImage } from "../../lib/section-images";

interface ProjectsData {
  hero?: {
    badge?: string;
    headline?: string;
    subtitle?: string;
    actions?: {
      primary?: { label: string; href: string };
      secondary?: { label: string; href: string };
    };
  };
  featuredProjects?: {
    stage?: string;
    title: string;
    description?: string;
    result?: string;
    tags: string[];
    url?: string;
    image?: string;
    imageAlt?: string;
  }[];
  timeline?: { phase: string; detail: string }[];
}

interface Props {
  page: ProjectsData;
  locale: SiteLocale;
  strings: {
    featuredTitle: string;
    featuredSubtitle: string;
    timelineTitle: string;
    timelineSubtitle: string;
    visitExternal: string;
    viewDetails: string;
  };
}

const { page, strings } = Astro.props;
const hero = page.hero;
const projects = page.featuredProjects ?? [];
const timeline = page.timeline ?? [];
const projectsImage = sectionImage("projects");
const heroActions = [hero?.actions?.primary, hero?.actions?.secondary].filter(
  (a): a is { label: string; href: string } => Boolean(a?.label && a?.href),
);
---

<Banner
  id="top"
  variant="page"
  kicker={hero?.badge}
  title={hero?.headline ?? ""}
  subtitle={hero?.subtitle}
  image={projectsImage}
  actions={heroActions}
  actionStyle="text"
/>

<section class="section reveal-on-scroll" id="featured">
  <SectionHeading title={strings.featuredTitle} subtitle={strings.featuredSubtitle} />
  {
    projects.length > 0 && (
      <Card variant="featured">
        <div
          slot="media"
          class:list={["card-featured-visual", { "card-featured-visual--image": Boolean(projects[0].image) }]}
        >
          {projects[0].image ? (
            <img
              src={projects[0].image}
              alt={projects[0].imageAlt || projects[0].title}
              width="960"
              height="600"
              loading="eager"
              decoding="async"
            />
          ) : (
            <span aria-hidden="true">
              {projects[0].title?.includes("astro") || projects[0].title?.includes("站") || projects[0].title?.includes("site") ? "🛰" : projects[0].title?.includes("Agent") || projects[0].title?.includes("蜂群") || projects[0].title?.includes("Swarm") ? "🐝" : projects[0].title?.includes("知识") || projects[0].title?.includes("Obsidian") || projects[0].title?.includes("Knowledge") ? "🧠" : "✦"}
            </span>
          )}
        </div>
        <p slot="kicker" class="card-kicker">{projects[0].stage}</p>
        <h3 slot="title" class="text-breathe">{projects[0].title}</h3>
        <p>{projects[0].description}</p>
        {projects[0].result && <p class="result-line">{projects[0].result}</p>}
        <ul class="chip-list">
          {projects[0].tags.map((tag) => <li>{tag}</li>)}
        </ul>
        {projects[0].url && (
          <p slot="action">
            <a
              class="site-banner__link text-breathe"
              style="display:inline-flex;margin-top:0.5rem"
              href={projects[0].url}
              target={projects[0].url.startsWith("http") ? "_blank" : undefined}
              rel={projects[0].url.startsWith("http") ? "noreferrer" : undefined}
            >
              {projects[0].url.startsWith("http") ? strings.visitExternal : strings.viewDetails}
            </a>
          </p>
        )}
      </Card>
    )
  }
  {
    projects.length > 1 && (
      <div class="blog-list-grid" style="margin-top:1rem">
        {
          projects.slice(1).map((project) => (
            <Card variant="work">
              {project.image && (
                <figure slot="media" class="ink-card__media project-card-thumb">
                  <img
                    src={project.image}
                    alt={project.imageAlt || project.title}
                    width="640"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
              <p slot="kicker" class="card-kicker">{project.stage}</p>
              <h3 slot="title" class="text-breathe">{project.title}</h3>
              <p>{project.description}</p>
              {project.result && <p class="result-line">{project.result}</p>}
              <ul class="chip-list">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              {project.url && (
                <p slot="action">
                  <a
                    class="text-breathe"
                    href={project.url}
                    target={project.url.startsWith("http") ? "_blank" : undefined}
                    rel={project.url.startsWith("http") ? "noreferrer" : undefined}
                  >
                    {project.url.startsWith("http") ? strings.visitExternal : strings.viewDetails}
                  </a>
                </p>
              )}
            </Card>
          ))
        }
      </div>
    )
  }
</section>

<section class="section reveal-on-scroll">
  <SectionHeading title={strings.timelineTitle} subtitle={strings.timelineSubtitle} />
  <div class="timeline">
    {
      timeline.map((item) => (
        <article class="card-accent-stripe">
          <p class="card-kicker">{item.phase}</p>
          <p>{item.detail}</p>
        </article>
      ))
    }
  </div>
</section>
