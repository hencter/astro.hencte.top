---
import type { SiteLocale } from "../../lib/i18n";
import { getDateLocale } from "../../lib/i18n";
import Banner from "../Banner.astro";
import Card from "../Card.astro";
import CtaBanner from "../CtaBanner.astro";
import EditorialListItem from "../EditorialListItem.astro";
import SectionHeading from "../SectionHeading.astro";
import { sectionImage } from "../../lib/section-images";

/**
 * Home hub — one-scroll narrative front door (minimalist revision).
 * Order: hero -> jump chips -> recent writing (+ fiction pointer) ->
 * featured projects -> contact CTA (about intro merged into banner).
 * Reading comes first; detail pages stay as deep links for SEO.
 */
interface HomeData {
  hero?: {
    badge?: string;
    headline?: string;
    subtitle?: string;
    actions?: {
      primary?: { label: string; href: string };
      secondary?: { label: string; href: string };
    };
  };
  projectsSection?: { title?: string; subtitle?: string };
  featuredProjects?: {
    stage?: string;
    title: string;
    description?: string;
    outcome?: string;
    tags: string[];
    url?: string;
    image?: string;
    imageAlt?: string;
  }[];
  latestSection?: { title?: string; subtitle?: string };
  cta?: {
    title?: string;
    text?: string;
    actions?: {
      primary?: { label: string; href: string };
      secondary?: { label: string; href: string };
    };
  };
}

interface LatestPost {
  id: string;
  data: {
    title: string;
    description?: string;
    date?: Date;
    section?: string;
  };
}

interface Props {
  home: HomeData;
  locale: SiteLocale;
  latestPosts: LatestPost[];
  strings: {
    datePending: string;
    readMore: string;
    visitProject: string;
    viewPage: string;
    wechatQrAlt: string;
    hubWriting: string;
    hubProjects: string;
    hubAbout: string;
    hubContact: string;
    aboutTitle: string;
    aboutBody: string;
    aboutCta: string;
    viewNovels: string;
    viewAllProjects: string;
  };
}

const { home, locale, latestPosts, strings } = Astro.props;

const hero = home.hero;
const projectsSection = home.projectsSection;
const featuredProjects = home.featuredProjects ?? [];
const latestSection = home.latestSection;
const cta = home.cta;

const root = locale === "en-US" ? "/en" : locale === "zh-TW" ? "/tw" : locale === "zh-HK" ? "/hk" : "";
const projectsHref = `${root}/projects`;
const novelHref = `${root}/shelf`;
const aboutHref = `${root}/about`;

const writingTitle = latestSection?.title ?? (locale === "en-US" ? "Recent writing" : "最新写作");
const projectsTitle = projectsSection?.title ?? (locale === "en-US" ? "Featured projects" : "重点项目");
const homeImage = sectionImage("home");
const heroActions = [hero?.actions?.primary].filter(
  (a): a is { label: string; href: string } => Boolean(a?.label && a?.href),
);

function formatDate(date?: Date): string {
  if (!date) return strings.datePending;
  return date.toLocaleDateString(getDateLocale(locale), {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: locale === "en-US" ? "short" : "2-digit",
    day: "2-digit",
  });
}

function featuredIcon(title: string): string {
  const t = title.toLowerCase();
  if (t.includes("astro") || t.includes("site") || title.includes("站")) return "🛰";
  if (t.includes("agent") || t.includes("swarm") || title.includes("蜂群")) return "🐝";
  if (title.includes("知识") || title.includes("Obsidian") || t.includes("obsidian") || t.includes("knowledge")) return "🧠";
  return "✦";
}
---

<Banner
  id="top"
  variant="page"
  kicker={hero?.badge}
  title={hero?.headline ?? (locale === "en-US" ? "Hencter" : "亦幸")}
  subtitle={hero?.subtitle}
  image={homeImage}
  actions={heroActions}
  actionStyle="button"
/>

<nav class="hub-jump" aria-label={locale === "en-US" ? "On this page" : "本页导航"}>
  <a href="#hub-writing" class="hub-chip text-breathe">{strings.hubWriting}</a>
  <a href="#hub-projects" class="hub-chip text-breathe">{strings.hubProjects}</a>
  <a href="#contact" class="hub-chip text-breathe">{strings.hubContact}</a>
</nav>

<section class="section reveal-on-scroll" id="hub-writing">
  <SectionHeading title={writingTitle} subtitle={latestSection?.subtitle} />
  <div class="post-list">
    {
      latestPosts.slice(0, 4).map((post) => (
        <EditorialListItem
          kicker={post.data.section || "blog"}
          title={post.data.title}
          href={`/${post.id}`}
          date={formatDate(post.data.date)}
          description={post.data.description || strings.readMore}
          prefetch
        />
      ))
    }
  </div>
  <p class="hub-more"><a class="text-breathe" href={novelHref} data-astro-prefetch="hover">{strings.viewNovels}</a></p>
</section>

<section class="section reveal-on-scroll" id="hub-projects">
  <SectionHeading title={projectsTitle} subtitle={projectsSection?.subtitle} />
  {
    featuredProjects.length > 0 && (
      <Card variant="featured">
        <div
          slot="media"
          class:list={["card-featured-visual", { "card-featured-visual--image": Boolean(featuredProjects[0].image) }]}
        >
          {featuredProjects[0].image ? (
            <img
              src={featuredProjects[0].image}
              alt={featuredProjects[0].imageAlt || featuredProjects[0].title}
              width="960"
              height="600"
              loading="eager"
              decoding="async"
            />
          ) : (
            <span aria-hidden="true">{featuredIcon(featuredProjects[0].title)}</span>
          )}
        </div>
        <p slot="kicker" class="card-kicker">{featuredProjects[0].stage}</p>
        <h3 slot="title">{featuredProjects[0].title}</h3>
        <p>{featuredProjects[0].description}</p>
        <p class="result-line">{featuredProjects[0].outcome}</p>
        <ul class="chip-list">
          {featuredProjects[0].tags.map((tag) => <li>{tag}</li>)}
        </ul>
        {featuredProjects[0].url && (
          <p slot="action">
            <a
              class="btn-secondary"
              style="display:inline-flex;margin-top:0.5rem"
              href={featuredProjects[0].url}
              target={featuredProjects[0].url.startsWith("http") ? "_blank" : undefined}
              rel={featuredProjects[0].url.startsWith("http") ? "noreferrer" : undefined}
            >
              {featuredProjects[0].url.startsWith("http") ? strings.visitProject : strings.viewPage}
            </a>
          </p>
        )}
      </Card>
    )
  }
  {
    featuredProjects.length > 1 && (
      <div class="card-grid two hub-project-grid">
        {
          featuredProjects.slice(1, 3).map((project) => (
            <Card variant="work">
              {project.image && (
                <figure slot="media" class="project-card-thumb">
                  <img
                    src={project.image}
                    alt={project.imageAlt || project.title}
                    width="640"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              )}
              <p slot="kicker" class="card-kicker">{project.stage}</p>
              <h3 slot="title">{project.title}</h3>
              <p>{project.description}</p>
              <p class="result-line">{project.outcome}</p>
              <ul class="chip-list">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              {project.url && (
                <p slot="action">
                  <a
                    href={project.url}
                    target={project.url.startsWith("http") ? "_blank" : undefined}
                    rel={project.url.startsWith("http") ? "noreferrer" : undefined}
                  >
                    {project.url.startsWith("http") ? strings.visitProject : strings.viewPage}
                  </a>
                </p>
              )}
            </Card>
          ))
        }
      </div>
    )
  }
  <p class="hub-more"><a class="text-breathe" href={projectsHref} data-astro-prefetch="hover">{strings.viewAllProjects}</a></p>
</section>

<section class="section reveal-on-scroll">
  <CtaBanner
    variant={locale === "en-US" ? "default" : "split"}
    title={cta?.title ?? (locale === "en-US" ? "Follow project updates" : "欢迎关注项目更新")}
    text={[strings.aboutBody, cta?.text].filter(Boolean).join(" ")}
    primary={cta?.actions?.primary}
    secondary={cta?.actions?.secondary ?? { label: strings.aboutCta, href: aboutHref }}
  >
    {locale !== "en-US" && (
      <img
        class="cta-banner__qr"
        src="/qr-wechat.svg"
        alt={strings.wechatQrAlt}
        width="140"
        height="140"
        loading="lazy"
      />
    )}
  </CtaBanner>
</section>

<style>
  .hub-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .hub-chip {
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-glass);
    padding: 0.34rem 0.85rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--ink-700);
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .hub-chip:hover,
  .hub-chip:focus-visible {
    color: var(--ink-900);
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 10%, var(--surface) 90%);
  }

  .hub-project-grid {
    margin-top: 1rem;
  }

  .hub-more {
    margin: 1.35rem 0 0;
  }

  .hub-more a {
    font-weight: 700;
    color: var(--brand-deep);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0% 100% / 0% 2px no-repeat;
  }

  .hub-more a:hover,
  .hub-more a:focus-visible {
    color: var(--accent);
    background-size: 100% 2px;
  }
</style>