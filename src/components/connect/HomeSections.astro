---
import type { SiteLocale } from "../../lib/i18n";
import { getDateLocale } from "../../lib/i18n";
import CtaBanner from "../CtaBanner.astro";
import EditorialListItem from "../EditorialListItem.astro";
import Hero from "../Hero.astro";
import SectionHeading from "../SectionHeading.astro";

/**
 * Home hub — one-scroll narrative front door (2026-09-03 redesign).
 * Order: hero -> in-page jump chips -> featured projects -> recent
 * writing (+ fiction pointer) -> about teaser -> contact CTA.
 * Detail pages (about/projects/blog/links) stay as deep links for SEO.
 */
interface HomeData {
  hero?: {
    badge?: string;
    headline?: string;
    subtitle?: string;
    actions?: {
      primary?: { label: string; href: string };
      secondary?: { label: string; href: string };
    };
  };
  projectsSection?: { title?: string; subtitle?: string };
  featuredProjects?: {
    stage?: string;
    title: string;
    description?: string;
    outcome?: string;
    tags: string[];
    url?: string;
  }[];
  latestSection?: { title?: string; subtitle?: string };
  cta?: {
    title?: string;
    text?: string;
    actions?: {
      primary?: { label: string; href: string };
      secondary?: { label: string; href: string };
    };
  };
}

interface LatestPost {
  id: string;
  data: {
    title: string;
    description?: string;
    date?: Date;
    section?: string;
  };
}

interface Props {
  home: HomeData;
  locale: SiteLocale;
  latestPosts: LatestPost[];
  strings: {
    datePending: string;
    readMore: string;
    visitProject: string;
    viewPage: string;
    wechatQrAlt: string;
    hubWriting: string;
    hubProjects: string;
    hubAbout: string;
    hubContact: string;
    aboutTitle: string;
    aboutBody: string;
    aboutCta: string;
    viewNovels: string;
    viewAllProjects: string;
  };
}

const { home, locale, latestPosts, strings } = Astro.props;

const hero = home.hero;
const projectsSection = home.projectsSection;
const featuredProjects = home.featuredProjects ?? [];
const latestSection = home.latestSection;
const cta = home.cta;

const root = locale === "en-US" ? "/en" : locale === "zh-TW" ? "/tw" : locale === "zh-HK" ? "/hk" : "";
const projectsHref = `${root}/projects`;
const blogHref = `${root}/blog`;
const novelHref = `${root}/novel`;
const aboutHref = `${root}/about`;

const writingTitle = latestSection?.title ?? (locale === "en-US" ? "Recent writing" : "最新写作");
const projectsTitle = projectsSection?.title ?? (locale === "en-US" ? "Featured projects" : "重点项目");

function formatDate(date?: Date): string {
  if (!date) return strings.datePending;
  return date.toLocaleDateString(getDateLocale(locale), {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: locale === "en-US" ? "short" : "2-digit",
    day: "2-digit",
  });
}

function featuredIcon(title: string): string {
  const t = title.toLowerCase();
  if (t.includes("astro") || t.includes("site") || title.includes("站")) return "🛰";
  if (t.includes("agent") || t.includes("swarm") || title.includes("蜂群")) return "🐝";
  if (title.includes("知识") || title.includes("Obsidian") || t.includes("obsidian") || t.includes("knowledge")) return "🧠";
  return "✦";
}
---

<Hero id="top" badge={hero?.badge} headline={hero?.headline} subtitle={hero?.subtitle} actions={hero?.actions} />

<nav class="hub-jump" aria-label={locale === "en-US" ? "On this page" : "本页导航"}>
  <a href="#hub-projects" class="hub-chip">{strings.hubProjects}</a>
  <a href="#hub-writing" class="hub-chip">{strings.hubWriting}</a>
  <a href="#hub-about" class="hub-chip">{strings.hubAbout}</a>
  <a href="#contact" class="hub-chip">{strings.hubContact}</a>
  <a href={blogHref} class="hub-chip hub-chip--ghost" data-astro-prefetch="hover">/blog</a>
</nav>

<section class="section reveal-on-scroll" id="hub-projects">
  <SectionHeading title={projectsTitle} subtitle={projectsSection?.subtitle} />
  {
    featuredProjects.length > 0 && (
      <article class="card-featured">
        <div class="card-featured-visual" aria-hidden="true">
          {featuredIcon(featuredProjects[0].title)}
        </div>
        <div class="card-featured-body">
          <p class="card-kicker">{featuredProjects[0].stage}</p>
          <h3>{featuredProjects[0].title}</h3>
          <p>{featuredProjects[0].description}</p>
          <p class="result-line">{featuredProjects[0].outcome}</p>
          <ul class="chip-list">
            {featuredProjects[0].tags.map((tag) => <li>{tag}</li>)}
          </ul>
          {featuredProjects[0].url && (
            <p>
              <a class="btn-secondary" style="display:inline-flex;margin-top:0.5rem"
                href={featuredProjects[0].url}
                target={featuredProjects[0].url.startsWith("http") ? "_blank" : undefined}
                rel={featuredProjects[0].url.startsWith("http") ? "noreferrer" : undefined}
              >
                {featuredProjects[0].url.startsWith("http") ? strings.visitProject : strings.viewPage}
              </a>
            </p>
          )}
        </div>
      </article>
    )
  }
  {
    featuredProjects.length > 1 && (
      <div class="card-grid three hub-project-grid">
        {
          featuredProjects.slice(1, 4).map((project) => (
            <article class="project-card">
              <p class="card-kicker">{project.stage}</p>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <p class="result-line">{project.outcome}</p>
              <ul class="chip-list">
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
              {project.url && (
                <p>
                  <a
                    href={project.url}
                    target={project.url.startsWith("http") ? "_blank" : undefined}
                    rel={project.url.startsWith("http") ? "noreferrer" : undefined}
                  >
                    {project.url.startsWith("http") ? strings.visitProject : strings.viewPage}
                  </a>
                </p>
              )}
            </article>
          ))
        }
      </div>
    )
  }
  <p class="hub-more"><a href={projectsHref} data-astro-prefetch="hover">{strings.viewAllProjects}</a></p>
</section>

<section class="section reveal-on-scroll" id="hub-writing">
  <SectionHeading title={writingTitle} subtitle={latestSection?.subtitle} />
  <div class="post-list">
    {
      latestPosts.slice(0, 4).map((post) => (
        <EditorialListItem
          kicker={post.data.section || "blog"}
          title={post.data.title}
          href={`/${post.id}`}
          date={formatDate(post.data.date)}
          description={post.data.description || strings.readMore}
          prefetch
        />
      ))
    }
  </div>
  <p class="hub-more"><a href={novelHref} data-astro-prefetch="hover">{strings.viewNovels}</a></p>
</section>

<section class="section reveal-on-scroll" id="hub-about">
  <SectionHeading title={strings.aboutTitle} />
  <p class="hub-about-body">{strings.aboutBody}</p>
  <p class="hub-more"><a href={aboutHref} data-astro-prefetch="hover">{strings.aboutCta}</a></p>
</section>

<section class="section reveal-on-scroll">
  <CtaBanner
    variant={locale === "en-US" ? "default" : "split"}
    title={cta?.title ?? (locale === "en-US" ? "Follow project updates" : "欢迎关注项目更新")}
    text={cta?.text ?? (locale === "en-US" ? "Start from the projects page for product overviews, then jump into the blog for implementation details and technical notes." : "你可以从项目页快速了解主要产品，也可以在博客中查看详细技术实现与复盘记录。")}
    primary={cta?.actions?.primary}
    secondary={cta?.actions?.secondary}
  >
    {locale !== "en-US" && (
      <img
        class="cta-banner__qr"
        src="/qr-wechat.svg"
        alt={strings.wechatQrAlt}
        width="140"
        height="140"
        loading="lazy"
      />
    )}
  </CtaBanner>
</section>

<style>
  .hub-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .hub-chip {
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface-glass);
    padding: 0.34rem 0.85rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: var(--ink-700);
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .hub-chip:hover,
  .hub-chip:focus-visible {
    color: var(--ink-900);
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 10%, var(--surface) 90%);
  }

  .hub-chip--ghost {
    font-weight: 600;
    color: var(--ink-500);
    background: transparent;
  }

  .hub-project-grid {
    margin-top: 1rem;
  }

  .hub-more {
    margin: 1.35rem 0 0;
  }

  .hub-more a {
    font-weight: 700;
    color: var(--brand-deep);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0% 100% / 0% 2px no-repeat;
    transition: background-size 350ms ease, color 200ms ease;
  }

  .hub-more a:hover,
  .hub-more a:focus-visible {
    color: var(--accent);
    background-size: 100% 2px;
  }

  .hub-about-body {
    max-width: 62ch;
    margin: 0;
    color: var(--ink-700);
    font-family: var(--font-serif);
    font-size: 1.06rem;
    line-height: 1.9;
  }
</style>
