---
/**
 * SectionHeading — editorial rail heading (no atmosphere image).
 * Partition hubs with optional bg use Banner instead.
 */
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="section-heading">
  <h2 class="section-title text-breathe">{title}</h2>
  {subtitle && <p class="section-subtitle">{subtitle}</p>}
</div>
