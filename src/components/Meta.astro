---
interface Props {
  title: string;
  description?: string;
  author?: string;
  keywords?: string[];
  applicationName?: string;
  locale?: "zh-CN" | "en-US";
  canonical?: string;
  image?: string;
  hreflang?: { "zh-CN"?: string; "en-US"?: string; "x-default"?: string };
}

const {
  title,
  description = "",
  author = "Hencter Lew",
  keywords = [],
  applicationName = "Hencter Studio",
  locale = "zh-CN",
  canonical,
  image = "/favicon.svg",
  hreflang,
} = Astro.props;

const localeTag = locale === "zh-CN" ? "zh_CN" : "en_US";
const keywordContent = keywords.join(", ");
const socialImage = new URL(image, Astro.url).toString();
const hreflangLinks = hreflang
  ? Object.entries(hreflang)
      .filter((entry): entry is [string, string] => Boolean(entry[1]))
      .map(([lang, path]) => ({ lang, href: new URL(path, Astro.url).toString() }))
  : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{keywordContent && <meta name="keywords" content={keywordContent} />}
<meta name="author" content={author} />
<meta name="application-name" content={applicationName} />
{canonical && <link rel="canonical" href={canonical} />}
{hreflangLinks.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}

<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:locale" content={localeTag} />
<meta property="og:site_name" content="亦幸小阁" />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialImage} />

<slot />
