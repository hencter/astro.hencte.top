---
import type { SiteLocale } from "../lib/i18n";
import { LOCALE_CONFIG } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  author?: string;
  keywords?: string[];
  applicationName?: string;
  locale?: SiteLocale;
  canonical?: string;
  image?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  robots?: string;
  hreflang?: Record<string, string>;
}

const {
  title,
  description = "",
  author = "Hencter Lew",
  keywords = [],
  applicationName = "Hencter Studio",
  locale = "zh-CN",
  canonical,
  image = "/og-image.png",
  ogType = "website",
  publishedTime,
  modifiedTime,
  robots,
  hreflang,
} = Astro.props;

const localeTag = LOCALE_CONFIG[locale].ogLocale;
const keywordContent = keywords.join(", ");
const socialImage = new URL(image, Astro.url).toString();
const hreflangLinks = hreflang
  ? Object.entries(hreflang)
      .filter((entry): entry is [string, string] => Boolean(entry[1]))
      .map(([lang, path]) => ({ lang, href: new URL(path, Astro.url).toString() }))
  : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="generator" content={Astro.generator} />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{keywordContent && <meta name="keywords" content={keywordContent} />}
<meta name="author" content={author} />
<meta name="application-name" content={applicationName} />
{robots && <meta name="robots" content={robots} />}
{canonical && <link rel="canonical" href={canonical} />}
{hreflangLinks.map(({ lang, href }) => (
  <link rel="alternate" hreflang={lang} href={href} />
))}
<link rel="alternate" type="application/rss+xml" title="亦幸小阁 RSS" href="https://hencte.top/rss.xml" />
<link rel="describedby" type="text/plain" href="https://hencte.top/llms.txt" />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:locale" content={localeTag} />
<meta property="og:site_name" content="亦幸小阁" />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={socialImage} />
{ogType === "article" && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{ogType === "article" && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:site" content="@hencter" />
<meta name="msvalidate.01" content="DE3B203227A8CF344D0A0F8E02B192CB" />
<slot />
