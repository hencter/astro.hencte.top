---
import BaseLayout from "./BaseLayout.astro";
import JsonLD from "../components/JsonLD.astro";
import EditorialListItem from "../components/EditorialListItem.astro";
import Hero from "../components/Hero.astro";

interface PostItem {
  title: string;
  href: string;
  date?: Date;
  description?: string;
  tags?: string[];
}

interface SectionItem {
  title: string;
  href: string;
  description?: string;
  count: number;
}

interface Props {
  title: string;
  description?: string;
  canonicalPath: string;
  badge?: string;
  posts: PostItem[];
  sections?: SectionItem[];
  locale?: "zh-CN" | "en-US";
}

const {
  title,
  description = "",
  canonicalPath,
  badge = "Blog",
  posts,
  sections = [],
  locale = "zh-CN",
} = Astro.props;

const isEnglish = locale === "en-US";

function formatDate(date?: Date): string {
  if (!date) {
    return isEnglish ? "Date pending" : "日期待补充";
  }
  return date.toLocaleDateString(isEnglish ? "en-US" : "zh-CN", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: isEnglish ? "short" : "2-digit",
    day: "2-digit",
  });
}

const blogNav = isEnglish
  ? [
      { href: "/en/blog", label: "All" },
      { href: "/log", label: "Log" },
      { href: "/tech", label: "Tech" },
      { href: "/novel", label: "Novel" },
      { href: "/ancient", label: "Ancient" },
    ]
  : [
      { href: "/blog", label: "全部" },
      { href: "/log", label: "日志" },
      { href: "/tech", label: "技术" },
      { href: "/novel", label: "小说" },
      { href: "/ancient", label: "古文" },
    ];

const labels = {
  home: isEnglish ? "Home" : "首页",
  blog: isEnglish ? "Blog" : "博客",
  subSections: isEnglish ? "Sub-sections" : "子栏目",
  posts: isEnglish ? "Posts" : "文章",
  empty: isEnglish ? "No public posts in this section yet." : "这个栏目还没有公开文章。",
  countSuffix: isEnglish ? "posts" : "篇文章",
};

const navActive = canonicalPath.replace(/\/+$/, "");
---

<BaseLayout
  title={`${title} | 亦幸小阁`}
  description={description || `${title} - ${isEnglish ? "blog section" : "博客栏目"}`}
  locale={locale}
  canonicalPath={canonicalPath}
  keywords={isEnglish ? ["blog", "section", title] : ["博客", "栏目", "亦幸小阁", title]}
>
  <JsonLD
    type="BreadcrumbList"
    breadcrumbs={[
      { name: labels.home, url: isEnglish ? "/en" : "/" },
      { name: labels.blog, url: isEnglish ? "/en/blog" : "/blog" },
      { name: title, url: canonicalPath },
    ]}
  />
  <Hero compact badge={badge} headline={title} subtitle={description}>
    <nav slot="before" class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={isEnglish ? "/en" : "/"}>{labels.home}</a></li>
        <li aria-hidden="true" class="breadcrumb-separator">›</li>
        <li><a href={isEnglish ? "/en/blog" : "/blog"}>{labels.blog}</a></li>
        <li aria-hidden="true" class="breadcrumb-separator">›</li>
        <li class="breadcrumb-current" aria-current="page">{title}</li>
      </ol>
    </nav>
    <nav class="blog-subnav" aria-label="Blog navigation">
      {
        blogNav.map((link) => (
          <a class={link.href === navActive ? "is-active" : undefined} href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </Hero>

  <section class="section reveal-on-scroll">
    <div class="post-prose read-container read-container--intro">
      <slot />
    </div>

    {sections.length > 0 && (
      <div class="section-block">
        <h2 class="section-title">{labels.subSections}</h2>
        <div class="card-grid three">
          {
            sections.map((section) => (
              <article class="project-card">
                <h3>
                  <a href={section.href} class="card-link">{section.title}</a>
                </h3>
                {section.description && <p>{section.description}</p>}
                <p class="result-line">{section.count} {labels.countSuffix}</p>
              </article>
            ))
          }
        </div>
      </div>
    )}

    <div class="section-block">
      <h2 class="section-title">{labels.posts}</h2>
      {posts.length === 0 ? (
        <p class="muted">{labels.empty}</p>
      ) : (
        <div class="post-list">
          {
            posts.map((post) => (
              <EditorialListItem
                title={post.title}
                href={post.href}
                date={formatDate(post.date)}
                description={post.description}
                tags={post.tags ?? []}
                maxTags={4}
                prefetch
                stretched
              />
            ))
          }
        </div>
      )}
    </div>
  </section>
</BaseLayout>
