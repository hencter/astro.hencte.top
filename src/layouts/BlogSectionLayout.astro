---
import BaseLayout from "./BaseLayout.astro";
import JsonLD from "../components/JsonLD.astro";
import EditorialListItem from "../components/EditorialListItem.astro";
import Banner from "../components/Banner.astro";
import { sectionImage } from "../lib/section-images";

interface PostItem {
  title: string;
  href: string;
  date?: Date;
  description?: string;
  tags?: string[];
}

interface SectionItem {
  title: string;
  href: string;
  description?: string;
  count: number;
}

interface Props {
  title: string;
  description?: string;
  canonicalPath: string;
  badge?: string;
  posts: PostItem[];
  sections?: SectionItem[];
  locale?: "zh-CN" | "en-US";
  /** Key under public/img/sections/ for optional Banner atmosphere */
  sectionKey?: string;
}

const {
  title,
  description = "",
  canonicalPath,
  badge = "Blog",
  posts,
  sections = [],
  locale = "zh-CN",
  sectionKey,
} = Astro.props;

const isEnglish = locale === "en-US";
const bannerImage = sectionImage(sectionKey || "blog");

function formatDate(date?: Date): string {
  if (!date) {
    return isEnglish ? "Date pending" : "日期待补充";
  }
  return date.toLocaleDateString(isEnglish ? "en-US" : "zh-CN", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: isEnglish ? "short" : "2-digit",
    day: "2-digit",
  });
}

const blogNav = isEnglish
  ? [
      // Honest peers only: section hubs (/log,/tech,…) are zh corpus today.
      // EN switcher goes to /en/blog; do not pretend /en/log exists.
      { href: "/en/blog", label: "All" },
      { href: "/en/shelf", label: "Shelf" },
    ]
  : [
      { href: "/blog", label: "全部" },
      { href: "/log", label: "日志" },
      { href: "/tech", label: "技术" },
      { href: "/shelf", label: "书架" },
      { href: "/ancient", label: "古文" },
    ];

const labels = {
  home: isEnglish ? "Home" : "首页",
  blog: isEnglish ? "Blog" : "博客",
  subSections: isEnglish ? "Sub-sections" : "子栏目",
  posts: isEnglish ? "Posts" : "文章",
  empty: isEnglish ? "No public posts in this section yet." : "这个栏目还没有公开文章。",
  countSuffix: isEnglish ? "posts" : "篇文章",
};

const navActive = canonicalPath.replace(/\/+$/, "");
---

<BaseLayout
  title={`${title} | 亦幸小阁`}
  description={description || `${title} - ${isEnglish ? "blog section" : "博客栏目"}`}
  locale={locale}
  canonicalPath={canonicalPath}
  connectPage="blog"
  keywords={isEnglish ? ["blog", "section", title] : ["博客", "栏目", "亦幸小阁", title]}
>
  <JsonLD
    type="BreadcrumbList"
    breadcrumbs={[
      { name: labels.home, url: isEnglish ? "/en" : "/" },
      { name: labels.blog, url: isEnglish ? "/en/blog" : "/blog" },
      { name: title, url: canonicalPath },
    ]}
  />
  <Banner
    variant="page"
    compact
    kicker={badge}
    title={title}
    subtitle={description}
    image={bannerImage}
  >
    <nav slot="before" class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={isEnglish ? "/en" : "/"}>{labels.home}</a></li>
        <li aria-hidden="true" class="breadcrumb-separator">›</li>
        <li><a href={isEnglish ? "/en/blog" : "/blog"}>{labels.blog}</a></li>
        <li aria-hidden="true" class="breadcrumb-separator">›</li>
        <li class="breadcrumb-current" aria-current="page">{title}</li>
      </ol>
    </nav>
    <nav class="blog-subnav" aria-label="Blog navigation">
      {
        blogNav.map((link) => (
          <a class={link.href === navActive ? "is-active" : undefined} href={link.href}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </Banner>

  <section class="section reveal-on-scroll">
    <div class="post-prose read-container read-container--intro">
      <slot />
    </div>

    {sections.length > 0 && (
      <div class="section-block">
        <h2 class="section-title">{labels.subSections}</h2>
        <div class="post-list">
          {
            sections.map((section) => (
              <EditorialListItem
                title={section.title}
                href={section.href}
                description={section.description}
                date={`${section.count} ${labels.countSuffix}`}
                prefetch
                stretched
              />
            ))
          }
        </div>
      </div>
    )}

    <div class="section-block">
      <h2 class="section-title">{labels.posts}</h2>
      {posts.length === 0 ? (
        <p class="muted">{labels.empty}</p>
      ) : (
        <div class="post-list">
          {
            posts.map((post) => (
              <EditorialListItem
                title={post.title}
                href={post.href}
                date={formatDate(post.date)}
                description={post.description}
                tags={post.tags ?? []}
                maxTags={4}
                prefetch
                stretched
              />
            ))
          }
        </div>
      )}
    </div>
  </section>
</BaseLayout>
