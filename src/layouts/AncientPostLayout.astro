---
import BaseLayout from "./BaseLayout.astro";

import "heti/umd/heti.min.css";
import hetiAddonUrl from "heti/umd/heti-addon.min.js?url";
import { Solar } from "lunar-javascript";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  date?: Date;
  canonicalPath: string;
  readingMinutes?: number;
  tags?: string[];
  categories?: string[];
  headings?: Heading[];
  layout?: "vertical" | "columns2";
}

const {
  title,
  description = "",
  date,
  canonicalPath,
  readingMinutes,
  tags = [],
  categories = [],
  headings = [],
  layout = "vertical",
} = Astro.props;

const hetiLayoutClass =
  layout === "columns2" ? "heti--columns-2" : "heti--vertical";

function formatSolarDate(value?: Date): string {
  if (!value) {
    return "日期待补充";
  }

  return value.toLocaleDateString("zh-CN", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}

function ymdInShanghai(value: Date): {
  year: number;
  month: number;
  day: number;
} {
  const text = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Asia/Shanghai",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(value);
  const [year, month, day] = text.split("-").map((item) => Number(item));
  return { year, month, day };
}

const solarDateText = formatSolarDate(date);
let lunarDateText = "";
if (date) {
  const { year, month, day } = ymdInShanghai(date);
  lunarDateText = Solar.fromYmd(year, month, day).getLunar().toString();
}

const keywords = [...categories, ...tags, "古文", "中文排版", "亦幸小阁"];
const hetiScopeId = "heti-ancient";
---

<BaseLayout
  title={`${title} | 亦幸小阁`}
  description={description || `${title} - 古文`}
  locale="zh-CN"
  canonicalPath={canonicalPath}
  keywords={keywords}
>
  <section class="section post-shell">
    <nav class="breadcrumb">
      <a href="/">首页</a>
      <span class="separator">›</span>
      <a href="/blog">博客</a>
      <span class="separator">›</span>
      <a href="/ancient">古文</a>
      <span class="separator">›</span>
      <span class="current">{title}</span>
    </nav>

    <header class="post-header">
      <p class="card-kicker">古文</p>
      <h1>{title}</h1>
      <div class="post-meta-line">
        <span>{solarDateText}</span>
        {lunarDateText && <span>农历 {lunarDateText}</span>}
        {readingMinutes && <span>约 {readingMinutes} 分钟阅读</span>}
      </div>

      {
        (tags.length > 0 || categories.length > 0) && (
          <ul class="chip-list">
            {categories.map((category) => (
              <li>{category}</li>
            ))}
            {tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      headings.length > 0 && (
        <div class="heti-scroll-wrapper">
          <aside class={`post-toc heti ${hetiLayoutClass}`}>
            <h2>目录</h2>
            <ul>
              {headings
                .filter((item) => item.depth <= 3)
                .map((item) => (
                  <li>
                    <a href={`#${item.slug}`}>{item.text}</a>
                  </li>
                ))}
            </ul>
          </aside>
        </div>
      )
    }

    <div class="heti-scroll-wrapper">
      <div
        id={hetiScopeId}
        class={`post-prose read-container read-container--cjk heti heti--ancient ${hetiLayoutClass}`}
      >
        <slot />
      </div>
    </div>

    <script src={hetiAddonUrl}></script>
    <script is:inline>
      function initHeti() {
        document.querySelectorAll(".heti-scroll-wrapper").forEach((wrapper) => {
          wrapper.scrollLeft = wrapper.scrollWidth;
        });
        if (typeof Heti !== "undefined") {
          const el = document.getElementById("heti-ancient");
          if (el) {
            const heti = new Heti("#heti-ancient");
            heti.autoSpacing();
          }
        }
      }
      initHeti();
      document.addEventListener("astro:after-swap", initHeti);
    </script>
  </section>
</BaseLayout>
