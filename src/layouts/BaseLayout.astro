---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Meta from "@components/Meta.astro";
import JsonLD from "@components/JsonLD.astro";
import WechatWidget from "@components/WechatWidget.astro";
import LocaleSelect from "@components/LocaleSelect.astro";
import {
  type SiteLocale,
  LOCALE_CONFIG,
  getNavLinks,
  getLanguageLinks,
  getBrandTagline,
  type ConnectPage,
} from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  locale?: SiteLocale;
  canonicalPath?: string;
  keywords?: string[];
  connectPage?: ConnectPage;
  alternates?: Record<string, string>;
  ogType?: "website" | "article";
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  robots?: string;
}

const {
  title = "亦幸小阁 | Personal Brand Hub",
  description = "把技术能力、内容表达和项目作品整合成可持续增长的个人品牌系统。",
  locale = "zh-CN",
  canonicalPath = Astro.url.pathname,
  keywords = [],
  connectPage,
  alternates,
  ogType = "website",
  image,
  publishedTime,
  modifiedTime,
  robots,
} = Astro.props;

const localeConfig = LOCALE_CONFIG[locale];
const brandName = "亦幸小阁";
const signatureName = "亦幸小阁";
const authorName = "Hencter Lew";
const brandTagline = getBrandTagline(locale);
const navLinks = getNavLinks(locale);
const languageLinks = connectPage ? getLanguageLinks(locale, connectPage) : [];

const canonical = new URL(canonicalPath, Astro.url).toString();
const hreflang = alternates;
const year = new Date().getFullYear();
const homeHref = localeConfig.path === "/" ? "/" : localeConfig.path;
const fontStylesheet =
  "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;700;800&family=Noto+Sans+SC:wght@400;500;700;900&family=Noto+Serif+SC:wght@400;600;700&family=ZCOOL+XiaoWei&display=swap";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";

function isNavActive(href: string): boolean {
  if (href.startsWith("#")) return false;
  const normalized = href.replace(/\/+$/, "") || "/";
  if (normalized === "/" || normalized === "/en" || normalized === "/tw" || normalized === "/hk") {
    return currentPath === normalized;
  }
  // Primary "Blog" also marks its section family (tech/log/ancient) active,
  // so visiting an article or section listing never leaves the nav empty.
  if (/\/blog$/.test(normalized)) {
    const prefix = normalized.slice(0, -5); // '' | '/en' | '/tw' | '/hk'
    const family = ["/tech", "/log", "/ancient"].map((root) => `${prefix}${root}`);
    return family.some(
      (root) => currentPath === root || currentPath.startsWith(`${root}/`)
    ) || currentPath === normalized || currentPath.startsWith(`${normalized}/`);
  }
  return currentPath === normalized || currentPath.startsWith(`${normalized}/`);
}
---

<!doctype html>
<html lang={localeConfig.htmlLang}>
  <head>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={fontStylesheet} />
    <link rel="stylesheet" href={fontStylesheet} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={fontStylesheet} />
    </noscript>
    <Meta
      title={title}
      description={description}
      locale={locale}
      keywords={keywords}
      canonical={canonical}
      hreflang={hreflang}
      applicationName={brandName}
      author={authorName}
      ogType={ogType}
      image={image}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      robots={robots}
    />
    <JsonLD type="Organization" pageDescription={description} />
    <JsonLD type="WebSite" pageDescription={description} />
    <ClientRouter />
    <script is:inline>
      // Theme initialization (before paint to prevent flash)
      ;(function() {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-0YT61J3M3T"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-0YT61J3M3T');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === "en-US" ? "Skip to content" : "跳转到主内容"}</a>
    <div class="ambient-bg" aria-hidden="true"></div>
    <div class="noise-overlay" aria-hidden="true"></div>
    <div class="page-shell">
      <header class="site-header">
        <a class="brand-link" href={homeHref}>
          <svg
            class="brand-mark"
            viewBox="0 0 48 48"
            role="img"
            aria-label="亦"
            focusable="false"
          >
            <rect x="1.5" y="1.5" width="45" height="45" rx="10" fill="var(--brand)" />
            <rect
              x="5.5"
              y="5.5"
              width="37"
              height="37"
              rx="6.5"
              fill="none"
              stroke="var(--bg)"
              stroke-opacity="0.55"
              stroke-width="1.2"
            />
            <text
              x="24"
              y="25"
              text-anchor="middle"
              dominant-baseline="central"
              font-size="26"
              fill="var(--bg)"
              style='font-family: var(--font-display), "Noto Serif SC", "Songti SC", serif'
            >亦</text>
          </svg>
          <span class="brand-copy">
            <strong>{brandName}</strong>
            <small>{brandTagline}</small>
          </span>
        </a>

        <div class="header-actions">
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label={locale === "en-US" ? "Toggle dark mode" : "切换深色模式"}>
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          {languageLinks.length > 0 && (
            <LocaleSelect
              links={languageLinks}
              label={locale === "en-US" ? "Switch language" : "切换语言"}
            />
          )}
        </div>

        <div class="nav-toggle">
          <button
            class="nav-toggle-btn"
            id="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="primary-nav"
            aria-label={locale === "en-US" ? "Open menu" : "打开菜单"}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="4" y1="7" x2="20" y2="7" />
              <line x1="4" y1="12" x2="20" y2="12" />
              <line x1="4" y1="17" x2="20" y2="17" />
            </svg>
          </button>
        </div>

        <div class="nav-panel" id="primary-nav">
          <nav aria-label={locale === "en-US" ? "Primary navigation" : "主导航"}>
            <ul class="nav-list">
              {
                navLinks.map((link) => {
                  const active = isNavActive(link.href);
                  return (
                    <li>
                      <a
                        href={link.href}
                        class={active ? "is-active" : undefined}
                        aria-current={active ? "page" : undefined}
                        data-astro-prefetch="hover"
                      >
                        {link.label}
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </nav>
        </div>
      </header>

      <main class="site-main" id="main-content" transition:animate="fade">
        <slot />
      </main>

      <footer class="site-footer" id="contact">
        <p>
          © {year} {signatureName}。Always a simple child who is happy to learn.
        </p>
        <a href="mailto:hencter@linktrust.top">hencter@linktrust.top</a>
      </footer>
    </div>

    <WechatWidget />

    <script>
      // Theme toggle logic
      function initThemeToggle() {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.toggle('dark');
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
      }

      // Scroll-driven reveal animation via IntersectionObserver
      function initScrollReveal() {
        const els = document.querySelectorAll('.reveal-on-scroll');
        if (!els.length) return;
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
        );
        els.forEach((el) => observer.observe(el));
      }

      // Mobile nav toggle
      function initMobileNav() {
        const btn = document.getElementById('nav-toggle');
        const panel = document.getElementById('primary-nav');
        if (!btn || !panel) return;

        btn.addEventListener('click', () => {
          const open = panel.classList.toggle('is-open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        panel.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            panel.classList.remove('is-open');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      // Reading focus chrome — hide nav (and the right TOC rail on
      // desktop) while scrolling down or while idle mid-article, so the
      // reader keeps the centered text column without chrome. Revealed
      // on scroll-up or when the pointer approaches the top edge.
      function initReadingChrome() {
        if (window.__readingChromeBound) return;
        const root = document.documentElement;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) return;

        const HIDE_AFTER = 2400;   // idle ms before chrome retreats
        const SCROLL_BEGIN = 160;  // px before down-scroll hides chrome
        const TOP_REVEAL = 96;     // pointer band that reveals chrome

        let lastY = window.scrollY;
        let idleTimer = 0;
        let atTop = window.scrollY < SCROLL_BEGIN;

        const apply = (hidden) => {
          root.classList.toggle('reading-chrome--hidden', hidden && !atTop);
        };

        const armIdle = () => {
          clearTimeout(idleTimer);
          idleTimer = setTimeout(() => {
            if (!atTop) apply(true);
          }, HIDE_AFTER);
        };

        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(() => {
            const y = window.scrollY;
            atTop = y < SCROLL_BEGIN;
            if (atTop) {
              apply(false);
            } else {
              const dy = y - lastY;
              if (Math.abs(dy) > 6) {
                if (dy > 0) {
                  apply(true);
                } else {
                  apply(false);
                  armIdle();
                }
              }
            }
            lastY = y;
            ticking = false;
          });
        };

        const onMove = (e) => {
          if (e.clientY < TOP_REVEAL && !atTop) apply(false);
        };

        window.__readingChromeBound = true;
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('mousemove', onMove, { passive: true });
        armIdle();
      }

      initThemeToggle();
      initScrollReveal();
      initMobileNav();
      initReadingChrome();

      document.addEventListener('astro:after-swap', () => {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        initThemeToggle();
        initScrollReveal();
        initMobileNav();
        initReadingChrome();
      });
    </script>
  </body>
</html>

