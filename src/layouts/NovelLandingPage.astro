---
import type { SiteLocale } from "../lib/i18n";
import { getNovelHref, htmlLangForLocale, getNovelUiStrings } from "../lib/novel-helpers";
import LocaleSelect from "../components/LocaleSelect.astro";
import JsonLD from "../components/JsonLD.astro";

interface Props {
  locale: SiteLocale;
  title: string;
  description: string;
  chapters: { title: string; href: string }[];
  novelSlug: string;
  comingSoon?: boolean;
  cover?: string;
  imageAlt?: string;
  languageLinks: { locale: SiteLocale; href: string; label: string; current: boolean }[];
  Content?: AstroComponentFactory | null;
  html?: string | null;
}

const {
  locale,
  title,
  description,
  chapters,
  novelSlug,
  comingSoon = false,
  cover,
  imageAlt = "",
  languageLinks,
  Content,
  html = null,
} = Astro.props;

const ui = getNovelUiStrings(locale);
const homeHref = locale === "zh-CN" ? "/" : locale === "en-US" ? "/en" : locale === "zh-TW" ? "/tw" : "/hk";
const novelIndexHref = getNovelHref(locale);
const canonical = new URL(Astro.url.pathname, Astro.url).toString();
const canonicalPath = Astro.url.pathname;
const htmlLang = htmlLangForLocale(locale);
---

<html lang={htmlLangForLocale(locale)}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | 亦幸小阁 小说</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, noai, noimageai, noarchive, nocache" />
    <JsonLD
      type="Book"
      book={{
        title,
        description,
        slug: novelSlug,
        chapterCount: chapters.length,
        genre: ["Fiction"],
      }}
      canonicalPath={canonicalPath}
      inLanguage={htmlLang}
    />
    <style is:global>
      :root{--bg:#f5f0e6;--surface:#fffcf5;--line:#d8cdba;--ink:#19150f;--muted:#5f5548;--brand:#b8792c;--accent:#a14932}
      :root.dark{--bg:#0b0907;--surface:#15110d;--line:#3b3021;--ink:#f2e8d9;--muted:#baac97;--brand:#d9aa4e;--accent:#c46a52}
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      body{font-family:"Noto Serif SC","Source Han Serif SC","Songti SC","SimSun",serif;background:var(--bg);color:var(--ink);line-height:1.9;padding:40px 24px;max-width:720px;margin:0 auto}
      a{color:var(--brand);text-decoration:none}a:hover{color:var(--accent)}
      .back{display:inline-block;margin-bottom:24px;font-size:14px}
      .top-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:24px;flex-wrap:wrap}
      h1{font-size:1.8em;margin-bottom:8px}
      .desc{color:var(--muted);margin-bottom:32px;font-size:15px}
      .cl{list-style:none;display:flex;flex-direction:column;gap:8px}
      .cl li{border:1px solid var(--line);border-radius:8px;transition:border-color .15s}
      .cl li:hover{border-color:var(--brand)}
      .cl a{display:block;padding:14px 20px;font-size:16px}
      .pb{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:16px 20px;margin-bottom:28px;display:none}
      .pb a{font-weight:600}
      .coming-soon{background:var(--surface);border:1px dashed var(--line);border-radius:10px;padding:20px;margin-bottom:24px}
      .prose{margin-bottom:24px}
      .series-cover{margin:0 auto 24px;max-width:320px;border-radius:10px;overflow:hidden;border:1px solid var(--line);box-shadow:0 4px 16px rgba(0,0,0,0.08)}
      .series-cover img{display:block;width:100%;height:auto}
    </style>
    <script is:inline>
      (function(){var s=localStorage.getItem('theme'),d=window.matchMedia('(prefers-color-scheme:dark)').matches;if(s==='dark'||(!s&&d))document.documentElement.classList.add('dark')})();
    </script>
  </head>
  <body>
    <div class="top-row">
      <a href={novelIndexHref} class="back">&larr; {ui.novelIndex}</a>
      <LocaleSelect links={languageLinks} label={ui.language} />
    </div>
    <h1>{title}</h1>
    {cover && (
      <figure class="series-cover">
        <img src={cover} alt={imageAlt || title} width="320" height="480" loading="lazy" decoding="async" />
      </figure>
    )}
    {description && <p class="desc">{description}</p>}
    {comingSoon && (
      <div class="coming-soon">
        <p>{ui.comingSoon}</p>
        <p><a href={getNovelHref("zh-CN", novelSlug)}>{ui.readZh}</a></p>
      </div>
    )}
    {(html || Content) && (
      <div class="prose">
        {html ? <div set:html={html} /> : Content ? <Content /> : null}
      </div>
    )}
    {!comingSoon && (
      <>
        <div class="pb" id="pb">
          <p>{ui.lastRead}：<a id="pl" href="#">—</a></p>
        </div>
        <ul class="cl">
          {chapters.map((ch) => <li><a href={ch.href}>{ch.title}</a></li>)}
        </ul>
      </>
    )}
    <div id="nvd" hidden data-ns={novelSlug} data-locale={locale}></div>
    <script is:inline define:vars={{ novelSlug, locale, novelIndexHref }}>
      var d = document.getElementById('nvd');
      var ns = d.dataset.ns;
      var loc = d.dataset.locale;
      var prefix = loc === 'en-US' ? '/en/novel/' : loc === 'zh-TW' ? '/tw/novel/' : loc === 'zh-HK' ? '/hk/novel/' : '/novel/';
      try{var p=localStorage.getItem('novel-progress-'+ns);if(p){var data=JSON.parse(p),b=document.getElementById('pb'),l=document.getElementById('pl');if(b&&l&&data.chapter){b.style.display='block';l.href=prefix+data.chapter;l.textContent=data.title||data.chapter}}}catch(e){}
    </script>
  </body>
</html>
