---
interface Props {
  title: string;
  description: string;
  chapters: { title: string; href: string }[];
  novelSlug: string;
}

const { title, description, chapters, novelSlug } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | 亦幸小阁 小说</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      :root{--bg:#f3f7fb;--surface:#fff;--line:#d8e2ef;--ink:#102238;--muted:#4d6582;--brand:#0e7490;--accent:#dd6b20}
      :root.dark{--bg:#0c1420;--surface:#15202e;--line:#243347;--ink:#e4ecf5;--muted:#7e97b2;--brand:#22d3ee;--accent:#fb923c}
      *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
      body{font-family:system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.7;padding:40px 24px;max-width:720px;margin:0 auto}
      a{color:var(--brand);text-decoration:none}a:hover{color:var(--accent)}
      .back{display:inline-block;margin-bottom:24px;font-size:14px}
      h1{font-size:1.8em;margin-bottom:8px}
      .desc{color:var(--muted);margin-bottom:32px;font-size:15px}
      .cl{list-style:none;display:flex;flex-direction:column;gap:8px}
      .cl li{border:1px solid var(--line);border-radius:8px;transition:border-color .15s}
      .cl li:hover{border-color:var(--brand)}
      .cl a{display:block;padding:14px 20px;font-size:16px}
      .pb{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:16px 20px;margin-bottom:28px;display:none}
      .pb a{font-weight:600}
    </style>
    <script is:inline>
      (function(){var s=localStorage.getItem('theme'),d=window.matchMedia('(prefers-color-scheme:dark)').matches;if(s==='dark'||(!s&&d))document.documentElement.classList.add('dark')})();
    </script>
  </head>
  <body>
    <a href="/novel" class="back">&larr; 小说目录</a>
    <h1>{title}</h1>
    {description && <p class="desc">{description}</p>}
    <div class="pb" id="pb">
      <p>上次读到：<a id="pl" href="#">—</a></p>
    </div>
    <ul class="cl">
      {chapters.map((ch) => <li><a href={ch.href}>{ch.title}</a></li>)}
    </ul>
    <div id="nvd" hidden data-ns={novelSlug}></div>
    <script is:inline>
      var d = document.getElementById('nvd');
      var ns = d.dataset.ns;
      try{var p=localStorage.getItem('novel-progress-'+ns);if(p){var d=JSON.parse(p),b=document.getElementById('pb'),l=document.getElementById('pl');if(b&&l&&d.chapter){b.style.display='block';l.href='/novel/'+d.chapter;l.textContent=d.title||d.chapter}}}catch(e){}
    </script>
  </body>
</html>
